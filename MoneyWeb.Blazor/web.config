<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Security headers: no framing (clickjacking), no MIME sniffing, no full URLs leaked to other sites. -->
      <httpProtocol>
        <customHeaders>
          <!-- The host (Plesk) always adds X-Frame-Options: SAMEORIGIN outside this config, so match it rather than send a
               conflicting value; CSP frame-ancestors (which modern browsers prefer) is what actually forbids all framing. -->
          <remove name="X-Powered-By" />
          <remove name="X-Powered-By-Plesk" />
          <remove name="X-Frame-Options" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Content-Security-Policy" value="frame-ancestors 'none'" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>
      <aspNetCore processPath="dotnet"
                  arguments=".\MoneyWeb.Blazor.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="OutOfProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
