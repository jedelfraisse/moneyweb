@page "/"
@using MoneyWeb.Blazor.Services
@using MoneyWeb.Data.Models
@using MoneyWeb.Data.Repositories.Interfaces
@using MoneyWeb.Data.Services
@inject CurrentUserService CurrentUserService
@inject IDebtRepository DebtRepository
@inject IBillRepository BillRepository
@inject ILoanRepository LoanRepository
@inject IIncomeRepository IncomeRepository
@inject ISinkingFundRepository SinkingFundRepository
@inject IMonthSnapshotService MonthSnapshotService

<PageTitle>MoneyWeb</PageTitle>

@* ── App description – visible to everyone ── *@
<h1>MoneyWeb</h1>
<p class="lead">
    MoneyWeb is a household finance planner that ties income, bills, debts, sinking funds, and loans
    together into one cash-flow picture — so you can see what's due, what's affordable, and what a payoff
    strategy actually costs before you commit to it.
</p>

@{
    // Shared template so the same Quick Links markup can be positioned above the dashboard
    // (anonymous/pending users have no dashboard to show) or below it (approved users —
    // dashboard is the primary view immediately after login, per issue #24).
    RenderFragment quickLinks = @<text>
        <h2 class="h4">Quick links</h2>
        <ul class="list-group mb-3">
            <li class="list-group-item"><a href="/bank-accounts">Bank Accounts</a> — Track account balances and view transactions.</li>
            <li class="list-group-item"><a href="/income">Income</a> — Manage recurring income sources and pay frequencies.</li>
            <li class="list-group-item"><a href="/debts">Debts</a> — Track balances, APRs, and payoff plans.</li>
            <li class="list-group-item"><a href="/bills">Bills</a> — Keep recurring monthly, quarterly, and annual expenses organized.</li>
            <li class="list-group-item"><a href="/sinking-funds">Sinking Funds</a> — Plan and save for irregular future expenses.</li>
            <li class="list-group-item"><a href="/loans">Loans</a> — Track money lent and incoming repayments.</li>
            <li class="list-group-item"><a href="/family">Family</a> — Manage family members and shared planning views.</li>
            <li class="list-group-item"><a href="/sharing">Sharing</a> — Invite and manage sharing permissions.</li>
            <li class="list-group-item"><a href="/account">Account</a> — Update your profile and feature preferences.</li>
            @if (_currentUser?.IsAdmin == true)
            {
                <li class="list-group-item"><a href="/admin/users">Admin Users</a> — Manage user access and approval.</li>
                <li class="list-group-item"><a href="/admin/stats">Admin Stats</a> — View application usage and totals.</li>
                <li class="list-group-item"><a href="/admin/maintenance">Admin Maintenance</a> — Run data cleanup utilities.</li>
            }
            <li class="list-group-item"><a href="/terms">Terms of Service</a> — Review terms and usage policies.</li>
            <li class="list-group-item"><a href="/privacy">Privacy Policy</a> — Review data and privacy details.</li>
        </ul>
    </text>;
}

@if (_loading)
{
    <p>Loading&hellip;</p>
}
else if (_currentUser is null)
{
    @* Not signed in *@
    <p><em>MoneyWeb is currently invite-only. Access is granted by an administrator after your account is created.</em></p>
    <p>
        <a href="/login" class="btn btn-primary">Sign in to get started</a>
    </p>
    <hr />
    @quickLinks
}
else if (!_currentUser.IsApproved)
{
    @* Signed in but awaiting approval *@
    <p><em>MoneyWeb is currently invite-only. Access is granted by an administrator after your account is created.</em></p>
    <div class="alert alert-info">
        <strong>Access pending.</strong> Your account has been created and is awaiting administrator approval.
        You'll have full access once approved.
        <br /><br />
        <a href="/account" class="btn btn-sm btn-outline-secondary me-2">View account status</a>
        <a href="/auth/logout" class="btn btn-sm btn-outline-secondary">Sign out</a>
    </div>
    <hr />
    @quickLinks
}
else
{
    @* Approved user – show dashboard summary *@
    <h2 class="mb-3">Dashboard</h2>

    @* ── This month: where do I stand right now? Hover (or tap) a tile for the items behind it. ── *@
    @if (_month is not null)
    {
        var m = _month;
        var paidCount = m.Paid.Count();
        var leftCount = m.Left.Count();
        <div class="card mb-4 border-primary">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-baseline mb-3 gap-2">
                    <h5 class="mb-0">@m.MonthStart.ToString("MMMM yyyy") — where you stand</h5>
                    <span class="text-muted small">Hover or tap a number for details</span>
                </div>
                <div class="row g-3">
                    <div class="col-sm-6 col-lg-3">
                        <div class="month-tile hover-detail" tabindex="0">
                            <div class="text-muted small">Bills &amp; payments paid</div>
                            <div class="fs-4 fw-bold text-success">@paidCount <span class="fs-6 fw-normal text-muted">of @m.Outgoing.Count</span></div>
                            <div class="small">@m.PaidTotal.ToString("C")</div>
                            <div class="hover-detail-panel">@ItemList(m.Paid, "Nothing paid yet this month.")</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="month-tile hover-detail" tabindex="0">
                            <div class="text-muted small">Still to pay</div>
                            <div class="fs-4 fw-bold @(m.OverdueCount > 0 ? "text-danger" : "text-warning")">@leftCount</div>
                            <div class="small">
                                @m.LeftTotal.ToString("C")
                                @if (m.OverdueCount > 0)
                                {
                                    <span class="badge bg-danger ms-1">@m.OverdueCount overdue</span>
                                }
                            </div>
                            <div class="hover-detail-panel">@ItemList(m.Left, "All paid for the month. 🎉")</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="month-tile hover-detail" tabindex="0">
                            <div class="text-muted small">Money in</div>
                            <div class="fs-4 fw-bold text-success">+@m.InTotal.ToString("C")</div>
                            <div class="small">@m.ReceivedTotal.ToString("C") received · @m.ExpectedTotal.ToString("C") to come</div>
                            <div class="hover-detail-panel">@ItemList(m.Incoming, "No income scheduled this month.")</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="month-tile hover-detail" tabindex="0">
                            <div class="text-muted small">Money out</div>
                            <div class="fs-4 fw-bold text-danger">−@m.OutTotal.ToString("C")</div>
                            <div class="small">@m.PaidTotal.ToString("C") paid · @m.LeftTotal.ToString("C") to go</div>
                            <div class="hover-detail-panel">@ItemList(m.Outgoing, "No bills or payments this month.")</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-4 mt-3 pt-3 border-top align-items-center">
                    <div>
                        <span class="text-muted small">Net for the month</span>
                        <span class="fs-5 fw-bold ms-1 @(m.Net >= 0 ? "text-success" : "text-danger")">@(m.Net >= 0 ? "+" : "−")@Math.Abs(m.Net).ToString("C")</span>
                    </div>
                    @if (m.Accounts.Count > 0)
                    {
                        <div class="hover-detail" tabindex="0">
                            <span class="text-muted small">Bank balance</span>
                            <span class="fw-bold ms-1">@m.BalanceNow.ToString("C")</span>
                            <span class="text-muted mx-1">→</span>
                            <span class="fw-bold @(m.BalanceEndOfMonth < 0 ? "text-danger" : "")">@m.BalanceEndOfMonth.ToString("C")</span>
                            <span class="text-muted small ms-1">by @m.MonthEnd.ToString("MMM d")</span>
                            <div class="hover-detail-panel">
                                <table class="table table-sm mb-1 small">
                                    <thead><tr><th>Account</th><th class="text-end">Now</th><th class="text-end">@m.MonthEnd.ToString("MMM d")</th></tr></thead>
                                    <tbody>
                                        @foreach (var a in m.Accounts)
                                        {
                                            <tr>
                                                <td>@a.Name</td>
                                                <td class="text-end">@a.Now.ToString("C")</td>
                                                <td class="text-end @(a.EndOfMonth < 0 ? "text-danger" : "")">@a.EndOfMonth.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="text-muted small">Checking &amp; savings, after everything still pending in cash flow through month end.</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* ── Scoreboard: the 3 headline numbers, full width ── *@
    var net = _monthlyIncome - _monthlyExpenses;
    var netPositive = net >= 0;
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 text-muted">Monthly Income</h6>
                    <p class="card-text fs-4 text-success fw-bold">@_monthlyIncome.ToString("C")</p>
                    <p class="card-text text-muted small">@_incomeSourceCount active source(s)</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 border-danger">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 text-muted">Monthly Expenses</h6>
                    <p class="card-text fs-4 text-danger fw-bold">@_monthlyExpenses.ToString("C")</p>
                    <p class="card-text text-muted small">Debts + bills + sinking funds</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 @(netPositive ? "border-success" : "border-warning")">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 text-muted">Net Monthly Cash Flow</h6>
                    <p class="card-text fs-4 fw-bold @(netPositive ? "text-success" : "text-warning")">
                        @(netPositive ? "+" : "")@net.ToString("C")
                    </p>
                    <p class="card-text small">
                        @if (netPositive)
                        {
                            <span class="text-success">✅ You're on track</span>
                        }
                        else
                        {
                            <span class="text-warning">⚠️ Expenses exceed income</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* ── Detail, grouped by category and balanced across two columns ── *@
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <h6 class="text-muted text-uppercase small fw-bold mb-2">Debt</h6>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 text-muted">Total Debt Balance</h6>
                    <p class="card-text fs-4">@_totalDebtBalance.ToString("C")</p>
                    <p class="card-text text-muted small">@_debtCount active debt(s)</p>
                </div>
            </div>
            @if (_creditCardCount > 0)
            {
                <div class="card mb-3 @(_avgCreditUsage >= 0.9m ? "border-danger" : _avgCreditUsage >= 0.3m ? "border-warning" : "border-success")">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-1 text-muted">Credit Card Usage</h6>
                        <p class="card-text fs-4 @(_avgCreditUsage >= 0.9m ? "text-danger" : _avgCreditUsage >= 0.3m ? "text-warning" : "text-success") fw-bold">
                            @((_avgCreditUsage * 100m).ToString("F1"))%
                        </p>
                        <p class="card-text text-muted small">@_creditCardCount card(s) · @_totalCreditBalance.ToString("C") of @_totalCreditLimit.ToString("C")</p>
                    </div>
                </div>
            }
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 text-muted">Monthly Debt Payments</h6>
                    <p class="card-text fs-5">@((_totalMinPayments + _totalDebtFees).ToString("C"))</p>
                    <p class="card-text text-muted small">
                        Min payments@(_totalDebtFees > 0 ? $" + {_totalDebtFees:C} fees (avg/mo)" : "")
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <h6 class="text-muted text-uppercase small fw-bold mb-2">Recurring &amp; Savings</h6>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 text-muted">Monthly Bills</h6>
                    <p class="card-text fs-5">@_monthlyBillTotal.ToString("C")</p>
                    <p class="card-text text-muted small">@_billCount active bill(s)</p>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 text-muted">Monthly Sinking Funds</h6>
                    <p class="card-text fs-5">@_monthlySinkingTotal.ToString("C")</p>
                    <p class="card-text text-muted small">@_sinkingFundCount active fund(s)</p>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-1 text-muted">Outstanding Loans</h6>
                    <p class="card-text fs-5">@_outstandingLoanBalance.ToString("C")</p>
                    <p class="card-text text-muted small">@_unsettledLoanCount unsettled loan(s)</p>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    @quickLinks
}

@code {
    private bool _loading = true;
    private User? _currentUser;
    private MonthSnapshot? _month;

    // Debt summary
    private int _debtCount;
    private decimal _totalDebtBalance;
    private decimal _totalMinPayments;
    private decimal _totalDebtFees;

    // Credit card usage summary
    private int _creditCardCount;
    private decimal _totalCreditBalance;
    private decimal _totalCreditLimit;
    private decimal _avgCreditUsage;

    // Bill summary
    private int _billCount;
    private decimal _monthlyBillTotal;

    // Income summary
    private int _incomeSourceCount;
    private decimal _monthlyIncome;

    // Sinking fund summary
    private int _sinkingFundCount;
    private decimal _monthlySinkingTotal;

    // Loan summary
    private int _unsettledLoanCount;
    private decimal _outstandingLoanBalance;

    // Budget totals
    private decimal _monthlyExpenses => _totalMinPayments + _totalDebtFees + _monthlyBillTotal + _monthlySinkingTotal;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await CurrentUserService.GetCurrentUserAsync();

        if (_currentUser?.IsApproved == true)
        {
            var debts = (await DebtRepository.GetAllAsync(_currentUser.Id, activeOnly: true)).ToList();
            _debtCount = debts.Count;
            _totalDebtBalance = debts.Sum(d => d.Balance);
            _totalMinPayments = debts.Sum(d => d.MinimumPayment);
            _totalDebtFees = debts.Sum(d => d.TotalMonthlyFees);

            var creditCards = debts.Where(d =>
                (d.DebtType == DebtType.CreditCard || d.DebtType == DebtType.LineOfCredit)
                && d.CreditLimit.HasValue && d.CreditLimit.Value > 0).ToList();
            _creditCardCount = creditCards.Count;
            _totalCreditBalance = creditCards.Sum(d => d.Balance);
            _totalCreditLimit = creditCards.Sum(d => d.CreditLimit!.Value);
            _avgCreditUsage = _totalCreditLimit > 0 ? _totalCreditBalance / _totalCreditLimit : 0m;

            var bills = (await BillRepository.GetAllAsync(_currentUser.Id, activeOnly: true)).ToList();
            _billCount = bills.Count;
            _monthlyBillTotal = bills.Sum(b => b.Frequency switch
            {
                BillFrequency.Monthly    => b.Amount,
                BillFrequency.Quarterly  => b.Amount / 3m,
                BillFrequency.Annual     => b.Amount / 12m,
                _                        => b.Amount
            });

            var incomes = (await IncomeRepository.GetAllAsync(_currentUser.Id, activeOnly: true)).ToList();
            _incomeSourceCount = incomes.Count;
            _monthlyIncome = incomes.Sum(i => i.Frequency switch
            {
                IncomeFrequency.Weekly      => i.EstimatedAmount * 52m / 12m,
                IncomeFrequency.BiWeekly    => i.EstimatedAmount * 26m / 12m,
                IncomeFrequency.SemiMonthly => i.EstimatedAmount * 2m,
                IncomeFrequency.Monthly     => i.EstimatedAmount,
                _                           => i.EstimatedAmount
            });

            var funds = (await SinkingFundRepository.GetAllAsync(_currentUser.Id, activeOnly: true)).ToList();
            _sinkingFundCount = funds.Count;
            _monthlySinkingTotal = funds.Sum(f => f.EffectiveMonthlyContribution);

            var loans = (await LoanRepository.GetAllAsync(_currentUser.Id, unsettledOnly: true)).ToList();
            _unsettledLoanCount = loans.Count;
            _outstandingLoanBalance = loans.Sum(l => l.Balance);

            _month = await MonthSnapshotService.GetAsync(_currentUser.Id, DateOnly.FromDateTime(DateTime.Today));
        }

        _loading = false;
    }

    private RenderFragment ItemList(IEnumerable<MonthItem> items, string emptyText)
    {
        var list = items.ToList();
        if (list.Count == 0)
            return @<div class="text-muted small fst-italic">@emptyText</div>;
        return @<table class="table table-sm mb-0 small">
            <tbody>
                @foreach (var i in list)
                {
                    <tr>
                        <td class="text-nowrap text-muted">@i.Date.ToString("MMM d")</td>
                        <td>
                            @i.Name
                            @if (i.Kind == MonthItemKind.Debt)
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">debt</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">@(i.IsEstimate ? "~" : "")@i.Amount.ToString("C")</td>
                        <td class="text-nowrap">@StatusBadge(i.Status)</td>
                    </tr>
                }
            </tbody>
        </table>;
    }

    private static RenderFragment StatusBadge(MonthItemStatus status) => status switch
    {
        MonthItemStatus.Paid        => @<span class="badge bg-success">Paid</span>,
        MonthItemStatus.Submitted   => @<span class="badge bg-info text-dark" title="Payment sent, waiting to clear">Submitted</span>,
        MonthItemStatus.AssumedPaid => @<span class="badge bg-success-subtle text-success-emphasis" title="Auto-draft — assumed paid by the bank">Auto-drafted</span>,
        MonthItemStatus.Overdue     => @<span class="badge bg-danger">Overdue</span>,
        MonthItemStatus.Received    => @<span class="badge bg-success">Received</span>,
        MonthItemStatus.Late        => @<span class="badge bg-warning text-dark" title="Pay date passed but not cleared in cash flow">Not cleared</span>,
        MonthItemStatus.Expected    => @<span class="badge bg-light text-dark border">Expected</span>,
        _                           => @<span class="badge bg-light text-dark border">Upcoming</span>
    };
}
