@page "/"
@rendermode InteractiveServer
@using MoneyWeb.Blazor.Services
@using MoneyWeb.Data.Models
@using MoneyWeb.Data.Repositories.Interfaces
@inject CurrentUserService CurrentUserService
@inject IUserRepository UserRepository
@inject IDebtRepository DebtRepository
@inject IBillRepository BillRepository
@inject ILoanRepository LoanRepository
@inject IIncomeRepository IncomeRepository
@inject ISinkingFundRepository SinkingFundRepository
@inject NavigationManager Navigation

<PageTitle>MoneyWeb</PageTitle>

@* ── App description – visible to everyone ── *@
<h1>MoneyWeb</h1>
<p class="lead">
    MoneyWeb is a household finance planner that ties income, bills, debts, sinking funds, and loans
    together into one cash-flow picture — so you can see what's due, what's affordable, and what a payoff
    strategy actually costs before you commit to it.
</p>

@{
    // Shared template so the same Quick Links markup can be positioned above the dashboard
    // (anonymous/pending users have no dashboard to show) or below it (approved users —
    // dashboard is the primary view immediately after login, per issue #24).
    RenderFragment quickLinks = @<text>
        <h2 class="h4">Quick links</h2>
        <ul class="list-group mb-3">
            <li class="list-group-item"><a href="/bank-accounts">Bank Accounts</a> — Track account balances and view transactions.</li>
            <li class="list-group-item"><a href="/income">Income</a> — Manage recurring income sources and pay frequencies.</li>
            <li class="list-group-item"><a href="/debts">Debts</a> — Track balances, APRs, and payoff plans.</li>
            <li class="list-group-item"><a href="/bills">Bills</a> — Keep recurring monthly, quarterly, and annual expenses organized.</li>
            <li class="list-group-item"><a href="/sinking-funds">Sinking Funds</a> — Plan and save for irregular future expenses.</li>
            <li class="list-group-item"><a href="/loans">Loans</a> — Track money lent and incoming repayments.</li>
            <li class="list-group-item"><a href="/family">Family</a> — Manage family members and shared planning views.</li>
            <li class="list-group-item"><a href="/sharing">Sharing</a> — Invite and manage sharing permissions.</li>
            @if (_currentUser?.IsAdmin == true)
            {
                <li class="list-group-item"><a href="/admin/users">Admin Users</a> — Manage user access and approval.</li>
                <li class="list-group-item"><a href="/admin/stats">Admin Stats</a> — View application usage and totals.</li>
                <li class="list-group-item"><a href="/admin/maintenance">Admin Maintenance</a> — Run data cleanup utilities.</li>
            }
            <li class="list-group-item"><a href="/terms">Terms of Service</a> — Review terms and usage policies.</li>
            <li class="list-group-item"><a href="/privacy">Privacy Policy</a> — Review data and privacy details.</li>
        </ul>
    </text>;
}

@if (_loading)
{
    <p>Loading&hellip;</p>
}
else if (_currentUser is null)
{
    @* Not signed in *@
    <p><em>MoneyWeb is currently invite-only. Access is granted by an administrator after your account is created.</em></p>
    <p>
        <a href="/login" class="btn btn-primary">Sign in to get started</a>
    </p>
    <hr />
    @quickLinks
}
else if (!_currentUser.IsApproved)
{
    @* Signed in but awaiting approval — same status/request-access UI the old Account page owned *@
    <div class="card mb-3" style="max-width:640px">
        <div class="card-body">
            <h5 class="card-title">Account Status</h5>
            @if (_currentUser.IsDeclined)
            {
                <span class="badge bg-danger">Declined</span>
                @if (!string.IsNullOrWhiteSpace(_currentUser.DeclineReason))
                {
                    <div class="text-muted small mt-1">Reason: @_currentUser.DeclineReason</div>
                }
                <div class="mt-2">
                    @if (!_requestingAgain)
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => _requestingAgain = true">
                            Request Access Again
                        </button>
                    }
                    else
                    {
                        <div>
                            <label class="form-label small">Why should you be approved?</label>
                            <textarea class="form-control form-control-sm mb-2" rows="2"
                                      placeholder="Briefly explain your reason..."
                                      @bind="_requestReasonInput"></textarea>
                            <button class="btn btn-sm btn-primary me-1" @onclick="SubmitAccessRequest">Send Request</button>
                            <button class="btn btn-sm btn-secondary" @onclick="() => _requestingAgain = false">Cancel</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <span class="badge bg-warning text-dark">Pending</span>
                <span class="text-muted small ms-2">Awaiting approval — features will unlock once approved</span>
                @if (!string.IsNullOrWhiteSpace(_currentUser.RequestReason))
                {
                    <div class="text-muted small fst-italic mt-1">Your note: @_currentUser.RequestReason</div>
                }
            }
        </div>
    </div>
    <p><em>MoneyWeb is currently invite-only. Access is granted by an administrator after your account is created.</em></p>
    <a href="/auth/logout" class="btn btn-sm btn-outline-secondary mb-3">Sign out</a>
    <hr />
    @quickLinks
}
else
{
    @* Approved user – dashboard + account, side by side *@
    <div class="row g-4">
        <div class="col-lg-8">
            <h2 class="mb-3">Dashboard</h2>

            @* ── Scoreboard: the 3 headline numbers, full width ── *@
            @{
                var net = _monthlyIncome - _monthlyExpenses;
                var netPositive = net >= 0;
            }
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="card h-100 border-success">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-1 text-muted">Monthly Income</h6>
                            <p class="card-text fs-4 text-success fw-bold">@_monthlyIncome.ToString("C")</p>
                            <p class="card-text text-muted small">@_incomeSourceCount active source(s)</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-danger">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-1 text-muted">Monthly Expenses</h6>
                            <p class="card-text fs-4 text-danger fw-bold">@_monthlyExpenses.ToString("C")</p>
                            <p class="card-text text-muted small">Debts + bills + sinking funds</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 @(netPositive ? "border-success" : "border-warning")">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-1 text-muted">Net Monthly Cash Flow</h6>
                            <p class="card-text fs-4 fw-bold @(netPositive ? "text-success" : "text-warning")">
                                @(netPositive ? "+" : "")@net.ToString("C")
                            </p>
                            <p class="card-text small">
                                @if (netPositive)
                                {
                                    <span class="text-success">✅ You're on track</span>
                                }
                                else
                                {
                                    <span class="text-warning">⚠️ Expenses exceed income</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Detail, grouped by category and balanced across two columns ── *@
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Debt</h6>
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-1 text-muted">Total Debt Balance</h6>
                            <p class="card-text fs-4">@_totalDebtBalance.ToString("C")</p>
                            <p class="card-text text-muted small">@_debtCount active debt(s)</p>
                        </div>
                    </div>
                    @if (_creditCardCount > 0)
                    {
                        <div class="card mb-3 @(_avgCreditUsage >= 0.9m ? "border-danger" : _avgCreditUsage >= 0.3m ? "border-warning" : "border-success")">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-1 text-muted">Credit Card Usage</h6>
                                <p class="card-text fs-4 @(_avgCreditUsage >= 0.9m ? "text-danger" : _avgCreditUsage >= 0.3m ? "text-warning" : "text-success") fw-bold">
                                    @((_avgCreditUsage * 100m).ToString("F1"))%
                                </p>
                                <p class="card-text text-muted small">@_creditCardCount card(s) · @_totalCreditBalance.ToString("C") of @_totalCreditLimit.ToString("C")</p>
                            </div>
                        </div>
                    }
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-1 text-muted">Monthly Debt Payments</h6>
                            <p class="card-text fs-5">@_totalMinPayments.ToString("C")</p>
                            <p class="card-text text-muted small">Sum of minimum payments</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Recurring &amp; Savings</h6>
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-1 text-muted">Monthly Bills</h6>
                            <p class="card-text fs-5">@_monthlyBillTotal.ToString("C")</p>
                            <p class="card-text text-muted small">@_billCount active bill(s)</p>
                        </div>
                    </div>
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-1 text-muted">Monthly Sinking Funds</h6>
                            <p class="card-text fs-5">@_monthlySinkingTotal.ToString("C")</p>
                            <p class="card-text text-muted small">@_sinkingFundCount active fund(s)</p>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-1 text-muted">Outstanding Loans</h6>
                            <p class="card-text fs-5">@_outstandingLoanBalance.ToString("C")</p>
                            <p class="card-text text-muted small">@_unsettledLoanCount unsettled loan(s)</p>
                        </div>
                    </div>
                </div>
            </div>

            @quickLinks
        </div>

        @* ── Account column ── *@
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Profile</h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">
                            @if (_editingName)
                            {
                                <div class="d-flex gap-2 align-items-center">
                                    <input class="form-control form-control-sm" @bind="_nameInput" style="max-width:150px" />
                                    <button class="btn btn-sm btn-primary" @onclick="SaveDisplayName">Save</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="() => _editingName = false">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <span>@_currentUser.DisplayName</span>
                                <button class="btn btn-link btn-sm p-0 ms-2" @onclick="StartEditName">edit</button>
                            }
                        </dd>
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@_currentUser.Email</dd>
                        <dt class="col-sm-4">Postal Code</dt>
                        <dd class="col-sm-8">
                            @if (_editingPostal)
                            {
                                <div class="d-flex gap-2 align-items-center">
                                    <input class="form-control form-control-sm" @bind="_postalInput" style="max-width:100px" />
                                    <button class="btn btn-sm btn-primary" @onclick="SavePostalCode">Save</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="() => _editingPostal = false">Cancel</button>
                                </div>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(_currentUser.PostalCode))
                                {
                                    <span>@_currentUser.PostalCode</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                                <button class="btn btn-link btn-sm p-0 ms-2" @onclick="StartEditPostal">edit</button>
                            }
                            <div class="text-muted small mt-1">Optional — used only for aggregate stats.</div>
                        </dd>
                        <dt class="col-sm-4">Member since</dt>
                        <dd class="col-sm-8">@_currentUser.CreatedAt.ToString("MMMM d, yyyy")</dd>
                        <dt class="col-sm-4">Account type</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">Free</span>
                            <div class="text-muted small mt-1">Full access to all features</div>
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Preferences</h5>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Cash Flow Horizon
                            <span class="text-muted fw-normal">— how far forward to project transactions</span>
                        </label>
                        <div class="d-flex align-items-center gap-3">
                            <div class="flex-grow-1">
                                <input type="range" class="form-range w-100"
                                       min="1" max="60" step="1"
                                       value="@_currentUser.CashFlowHorizonMonths"
                                       @oninput="e => _currentUser.CashFlowHorizonMonths = int.Parse(e.Value!.ToString()!)" />
                                <div class="d-flex justify-content-between">
                                    <small class="text-muted">1 month</small>
                                    <small class="text-end text-muted">5 years</small>
                                </div>
                            </div>
                            <span class="text-nowrap fw-semibold" style="min-width:6rem">
                                @_currentUser.CashFlowHorizonMonths mo
                                <span class="text-muted fw-normal small">(~@((_currentUser.CashFlowHorizonMonths / 12.0m).ToString("0.#")) yr)</span>
                            </span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Navigation Sections</label>
                        <div class="text-muted small mb-2">Show or hide optional sections in the top menu.</div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="toggleSinkingFunds"
                                   checked="@_currentUser.ShowSinkingFunds"
                                   @onchange="e => _currentUser.ShowSinkingFunds = (bool)e.Value!" />
                            <label class="form-check-label" for="toggleSinkingFunds">Sinking Funds</label>
                        </div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="toggleLoans"
                                   checked="@_currentUser.ShowLoans"
                                   @onchange="e => _currentUser.ShowLoans = (bool)e.Value!" />
                            <label class="form-check-label" for="toggleLoans">Loans</label>
                        </div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="toggleFamily"
                                   checked="@_currentUser.ShowFamily"
                                   @onchange="e => _currentUser.ShowFamily = (bool)e.Value!" />
                            <label class="form-check-label" for="toggleFamily">Family</label>
                        </div>
                    </div>

                    @if (_prefsSaved)
                    {
                        <div class="alert alert-success py-1 px-2 small mb-2">Preferences saved.</div>
                    }
                    <button class="btn btn-primary btn-sm" @onclick="SavePreferences">Save Preferences</button>
                </div>
            </div>

            <div class="card border-danger">
                <div class="card-body">
                    <h5 class="card-title text-danger">Danger Zone</h5>
                    <p class="text-muted small">
                        Permanently deletes all your debts, bills, loans, and transactions.
                        This cannot be undone.
                    </p>
                    @if (!_confirmingDelete)
                    {
                        <button class="btn btn-outline-danger" @onclick="() => _confirmingDelete = true">
                            Delete My Data
                        </button>
                    }
                    else
                    {
                        <p class="fw-bold text-danger">Are you absolutely sure?</p>
                        <button class="btn btn-danger me-2" @onclick="DeleteData">Yes, delete everything</button>
                        <button class="btn btn-secondary" @onclick="() => _confirmingDelete = false">Cancel</button>
                    }
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger mt-2">@_errorMessage</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private User? _currentUser;

    // Account column state
    private bool _editingName;
    private string _nameInput = string.Empty;
    private bool _editingPostal;
    private string _postalInput = string.Empty;
    private bool _requestingAgain;
    private string _requestReasonInput = string.Empty;
    private bool _prefsSaved;
    private bool _confirmingDelete;
    private string? _errorMessage;

    // Debt summary
    private int _debtCount;
    private decimal _totalDebtBalance;
    private decimal _totalMinPayments;

    // Credit card usage summary
    private int _creditCardCount;
    private decimal _totalCreditBalance;
    private decimal _totalCreditLimit;
    private decimal _avgCreditUsage;

    // Bill summary
    private int _billCount;
    private decimal _monthlyBillTotal;

    // Income summary
    private int _incomeSourceCount;
    private decimal _monthlyIncome;

    // Sinking fund summary
    private int _sinkingFundCount;
    private decimal _monthlySinkingTotal;

    // Loan summary
    private int _unsettledLoanCount;
    private decimal _outstandingLoanBalance;

    // Budget totals
    private decimal _monthlyExpenses => _totalMinPayments + _monthlyBillTotal + _monthlySinkingTotal;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await CurrentUserService.GetCurrentUserAsync();

        if (_currentUser?.IsApproved == true)
        {
            var debts = (await DebtRepository.GetAllAsync(_currentUser.Id, activeOnly: true)).ToList();
            _debtCount = debts.Count;
            _totalDebtBalance = debts.Sum(d => d.Balance);
            _totalMinPayments = debts.Sum(d => d.MinimumPayment);

            var creditCards = debts.Where(d =>
                (d.DebtType == DebtType.CreditCard || d.DebtType == DebtType.LineOfCredit)
                && d.CreditLimit.HasValue && d.CreditLimit.Value > 0).ToList();
            _creditCardCount = creditCards.Count;
            _totalCreditBalance = creditCards.Sum(d => d.Balance);
            _totalCreditLimit = creditCards.Sum(d => d.CreditLimit!.Value);
            _avgCreditUsage = _totalCreditLimit > 0 ? _totalCreditBalance / _totalCreditLimit : 0m;

            var bills = (await BillRepository.GetAllAsync(_currentUser.Id, activeOnly: true)).ToList();
            _billCount = bills.Count;
            _monthlyBillTotal = bills.Sum(b => b.Frequency switch
            {
                BillFrequency.Monthly    => b.Amount,
                BillFrequency.Quarterly  => b.Amount / 3m,
                BillFrequency.Annual     => b.Amount / 12m,
                _                        => b.Amount
            });

            var incomes = (await IncomeRepository.GetAllAsync(_currentUser.Id, activeOnly: true)).ToList();
            _incomeSourceCount = incomes.Count;
            _monthlyIncome = incomes.Sum(i => i.Frequency switch
            {
                IncomeFrequency.Weekly      => i.EstimatedAmount * 52m / 12m,
                IncomeFrequency.BiWeekly    => i.EstimatedAmount * 26m / 12m,
                IncomeFrequency.SemiMonthly => i.EstimatedAmount * 2m,
                IncomeFrequency.Monthly     => i.EstimatedAmount,
                _                           => i.EstimatedAmount
            });

            var funds = (await SinkingFundRepository.GetAllAsync(_currentUser.Id, activeOnly: true)).ToList();
            _sinkingFundCount = funds.Count;
            _monthlySinkingTotal = funds.Sum(f => f.EffectiveMonthlyContribution);

            var loans = (await LoanRepository.GetAllAsync(_currentUser.Id, unsettledOnly: true)).ToList();
            _unsettledLoanCount = loans.Count;
            _outstandingLoanBalance = loans.Sum(l => l.Balance);
        }

        _loading = false;
    }

    private void StartEditName()
    {
        _nameInput = _currentUser?.DisplayName ?? string.Empty;
        _editingName = true;
    }

    private async Task SaveDisplayName()
    {
        if (_currentUser is null || string.IsNullOrWhiteSpace(_nameInput)) return;
        _currentUser.DisplayName = _nameInput.Trim();
        await UserRepository.UpdateAsync(_currentUser);
        _editingName = false;
    }

    private void StartEditPostal()
    {
        _postalInput = _currentUser?.PostalCode ?? string.Empty;
        _editingPostal = true;
    }

    private async Task SavePostalCode()
    {
        if (_currentUser is null) return;
        _currentUser.PostalCode = _postalInput.Trim();
        await UserRepository.UpdateAsync(_currentUser);
        _editingPostal = false;
    }

    private async Task SubmitAccessRequest()
    {
        if (_currentUser is null || string.IsNullOrWhiteSpace(_requestReasonInput)) return;
        _currentUser.IsDeclined = false;
        _currentUser.DeclineReason = string.Empty;
        _currentUser.RequestReason = _requestReasonInput.Trim();
        await UserRepository.UpdateAsync(_currentUser);
        _requestingAgain = false;
        _requestReasonInput = string.Empty;
    }

    private async Task SavePreferences()
    {
        if (_currentUser is null) return;
        _currentUser.CashFlowHorizonMonths = Math.Clamp(_currentUser.CashFlowHorizonMonths, 1, 60);
        await UserRepository.UpdateAsync(_currentUser);
        _prefsSaved = true;
        _ = Task.Delay(3000).ContinueWith(_ => { _prefsSaved = false; InvokeAsync(StateHasChanged); });
    }

    private async Task DeleteData()
    {
        if (_currentUser is null) return;
        try
        {
            await UserRepository.DeleteUserDataAsync(_currentUser.Id);
            Navigation.NavigateTo("/auth/logout", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete data: {ex.Message}";
            _confirmingDelete = false;
        }
    }
}
