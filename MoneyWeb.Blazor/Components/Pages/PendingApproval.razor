@page "/pending-approval"
@layout Layout.MainLayout

<PageTitle>Pending Approval</PageTitle>

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="mb-3">Access Pending</h2>
                    <p class="text-muted mb-4">
                        Your account has been created and is awaiting approval.
                        You'll be notified once an administrator grants you access.
                    </p>
                    <a href="/auth/logout" class="btn btn-outline-secondary">Sign Out</a>
                </div>
            </div>
        </div>
    </div>
</div>
