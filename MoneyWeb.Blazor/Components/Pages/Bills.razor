@page "/bills"
@rendermode InteractiveServer
@using MoneyWeb.Blazor.Services
@using MoneyWeb.Data.Models
@using MoneyWeb.Data.Repositories.Interfaces
@using MoneyWeb.Data.Services

@inject CurrentUserService CurrentUserService
@inject IBillRepository BillRepo
@inject IBankAccountRepository AccountRepo
@inject ICashFlowRepository CashFlowRepo
@inject IBillCashFlowSyncService SyncSvc
@inject IBillPaymentService BillPaymentSvc
@inject SqidsEncoder<int> Sqids

<PageTitle>Bills – MoneyWeb</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Bills <PageInfoPopover Title="Bills" Content="Track recurring expenses — both manual payments you control and auto-draft charges. Bills are projected forward in your cash flow forecast so you can see upcoming obligations and time payments around your available balance." /></h2>
    <div class="d-flex gap-2 align-items-center">
        <div class="btn-group btn-group-sm" role="group" aria-label="Sort bills">
            <button class="btn @(_billSort == "date" ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick='() => _billSort = "date"'>📅 Next Due</button>
            <button class="btn @(_billSort == "name" ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick='() => _billSort = "name"'>🔤 Name</button>
        </div>
        <button class="btn btn-outline-secondary" disabled="@_checkingCashFlow" @onclick="CheckCashFlowAsync"
                title="Make sure each bill's upcoming payments are in its bank account — adds missing entries and removes outdated ones. Past-due, submitted and hand-edited entries are left alone.">
            @if (_checkingCashFlow) { <span class="spinner-border spinner-border-sm me-1"></span> }
            🔄 Check Cash Flow
        </button>
        <button class="btn btn-primary" @onclick="OpenAddBill">+ Add Bill</button>
    </div>
</div>

@if (_syncResult is { } sync)
{
    <div class="alert @(sync.Changed || _openMissingCashFlow.Count > 0 ? "alert-info" : "alert-success") alert-dismissible small">
        @if (sync.Changed)
        {
            <span>
                Checked @sync.BillsChecked bill@(sync.BillsChecked == 1 ? "" : "s") —
                added @sync.Added missing entr@(sync.Added == 1 ? "y" : "ies"),
                removed @sync.Removed outdated entr@(sync.Removed == 1 ? "y" : "ies").
            </span>
        }
        else
        {
            <span>✓ Checked @sync.BillsChecked bill@(sync.BillsChecked == 1 ? "" : "s") — the cash flow already matches.</span>
        }
        @if (_openMissingCashFlow.Count > 0)
        {
            <div class="mt-1">
                ⚠ @_openMissingCashFlow.Count open bill@(_openMissingCashFlow.Count == 1 ? " has" : "s have") no cash-flow entry —
                flagged below. Confirm or remove @(_openMissingCashFlow.Count == 1 ? "it" : "them").
            </div>
        }
        <button type="button" class="btn-close" @onclick="() => _syncResult = null"></button>
    </div>
}

@if (_bills.Count == 0)
{
    <div class="alert alert-info">No bills yet. Add your first recurring bill above.</div>
}
else
{
    var today0 = DateOnly.FromDateTime(DateTime.Today);
    Func<Bill, object> billSortKey = _billSort == "name"
        ? (b => (object)b.Name)
        : (b => (object)b.UpcomingDueDate(today0));
    var manualBills    = _bills.Where(b => b.PaymentMethod != DebtPaymentMethod.AutoDraft).OrderBy(billSortKey).ToList();
    var autoDraftBills = _bills.Where(b => b.PaymentMethod == DebtPaymentMethod.AutoDraft).OrderBy(billSortKey).ToList();
    // All open occurrences, auto-draft bills' included: one recorded with Record Amount stays open until its payment
    // clears, and hiding it here left it invisible everywhere but Catch Up.
    var openManual     = _openOccurrences.ToList();
    var autoDraftIds   = autoDraftBills.Select(b => b.Id).ToHashSet();

    @* ── Open Bills ── *@
    <div class="d-flex justify-content-between align-items-center mt-2 mb-2">
        <h5 class="mb-0">
            <span class="badge bg-warning text-dark me-1">Open Bills</span>
            Pending &amp; in-flight
            @if (openManual.Count > 0)
            { <span class="badge bg-danger ms-1">@openManual.Count</span> }
        </h5>
        <button class="btn btn-sm btn-outline-secondary" @onclick="OpenOneOffEntry">+ One-Off Bill</button>
    </div>
    @if (openManual.Count == 0)
    {
        <p class="text-muted small fst-italic mb-4">No open bills. Record an actual from a recurring bill below or add a one-off.</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th class="text-center">Due Date</th>
                        <th class="text-center">Plan to Pay</th>
                        <th class="text-end">Amount</th>
                        <th class="text-center">Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var occ in openManual.OrderBy(o => o.DueDate))
                    {
                        var today2 = DateOnly.FromDateTime(DateTime.Today);
                        var overdue = occ.DueDate < today2 && occ.Status != BillOccurrenceStatus.Submitted;
                        <tr class="@(overdue ? "table-danger" : "")">
                            <td class="fw-semibold">
                                @occ.DisplayName
                                @if (occ.IsOneOff) { <span class="badge bg-secondary ms-1 small">One-Off</span> }
                                @if (occ.BillId is { } obid && autoDraftIds.Contains(obid)) { <span class="badge bg-info-subtle text-info-emphasis ms-1 small" title="Auto-draft bill: ✓ Confirm once the draft has gone through">Auto-draft</span> }
                                @if (occ.SinkingFundId.HasValue) { <span class="badge bg-info-subtle text-info-emphasis ms-1 small" title="A sinking fund saved for this bill">Sinking fund</span> }
                                @if (_openMissingCashFlow.Contains(occ.Id))
                                {
                                    <span class="badge bg-light text-danger border border-danger ms-1 small"
                                          title="No pending payment for this bill in any bank account's cash flow. Use + Cash flow to schedule it, ✓ Confirm if it was already paid, or ✕ to remove it.">⚠ Not in cash flow</span>
                                }
                            </td>
                            <td class="text-center @(overdue ? "fw-semibold" : "")">@occ.DueDate.ToString("MMM d, yyyy")</td>
                            <td class="text-center text-muted small">@(occ.PlannedPayDate.HasValue ? occ.PlannedPayDate.Value.ToString("MMM d, yyyy") : "—")</td>
                            <td class="text-end">@((occ.ActualAmount ?? occ.EstimatedAmount).ToString("C"))</td>
                            <td class="text-center">@OccurrenceStatusBadge(occ.Status)</td>
                            <td class="text-end text-nowrap">
                                @if (_openMissingCashFlow.Contains(occ.Id))
                                {
                                    <button class="btn btn-sm btn-outline-primary me-1" title="Schedule this payment in a bank account's cash flow"
                                            @onclick="() => OpenAddToCashFlow(occ)">+ Cash flow</button>
                                }
                                @if (occ.Status is BillOccurrenceStatus.Estimated or BillOccurrenceStatus.Received)
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditOccurrence(occ)">Edit</button>
                                    <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => AdvanceOccurrenceStatus(occ, BillOccurrenceStatus.Submitted)">📤 Submit</button>
                                }
                                @if (occ.Status == BillOccurrenceStatus.Submitted)
                                {
                                    <button class="btn btn-sm btn-outline-success me-1" @onclick="() => AdvanceOccurrenceStatus(occ, BillOccurrenceStatus.Confirmed)">✓ Confirm</button>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _deletingOccurrence = occ">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (manualBills.Count > 0)
    {
        <h5 class="mt-2 mb-2">
            <span class="badge bg-secondary me-1">Manual</span>
            Bills I pay myself
        </h5>
        <div class="table-responsive mb-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th></th><th>Name</th><th>Category</th><th>Frequency</th>
                        <th class="text-end">Est. Amount</th><th class="text-center">Next Due</th>
                        <th>Bank Account</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in manualBills)
                    {
                        var today   = DateOnly.FromDateTime(DateTime.Today);
                        var nextDue = bill.UpcomingDueDate(today);
                        var dueSoon = nextDue <= today.AddDays(14);
                        <tr class="@(!bill.IsActive ? "text-muted" : "")">
                            <td class="text-center" style="width:28px">
                                <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleExpand(bill.Id)">
                                    @(_expanded.Contains(bill.Id) ? "▲" : "▼")
                                </button>
                            </td>
                            <td class="fw-semibold">
                                @bill.Name
                                @if (!bill.IsActive) { <span class="badge bg-secondary ms-1">Inactive</span> }
                            </td>
                            <td><span class="badge bg-light text-dark border">@bill.Category</span></td>
                            <td>@FrequencyLabel(bill.Frequency)</td>
                            <td class="text-end">@bill.Amount.ToString("C")</td>
                            <td class="text-center @(dueSoon ? "fw-semibold text-danger" : "")">@nextDue.ToString("MMM d, yyyy")</td>
                            <td class="text-muted small">@(bill.BankAccountName ?? "—")</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-success me-1" @onclick="() => OpenEnterActual(bill)"
                                        title="Add a payment for this bill">
                                    ➕ Add Bill
                                </button>
                                @if (bill.BankAccountId.HasValue)
                                {
                                    <a class="btn btn-sm btn-link p-0 me-1 text-muted" href="/transactions/@Sqids.Encode(bill.BankAccountId!.Value)">View →</a>
                                }
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditBill(bill)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(bill)">Delete</button>
                            </td>
                        </tr>
                        @if (_expanded.Contains(bill.Id))
                        {
                            <tr>
                                <td colspan="8" class="p-0 border-top-0">
                                    <div class="bg-light px-4 py-2">
                                        @if (!_occurrences.TryGetValue(bill.Id, out var occs) || occs.Count == 0)
                                        {
                                            <span class="text-muted small fst-italic">No recorded history yet.</span>
                                        }
                                        else
                                        {
                                            <table class="table table-sm mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Due Date</th><th>Plan to Pay</th>
                                                        <th class="text-end">Estimated</th><th class="text-end">Actual</th>
                                                        <th class="text-center">Status</th><th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var occ in occs)
                                                    {
                                                        <tr>
                                                            <td>@occ.DueDate.ToString("MMM d, yyyy")</td>
                                                            <td class="text-muted small">@(occ.PlannedPayDate.HasValue ? occ.PlannedPayDate.Value.ToString("MMM d, yyyy") : "—")</td>
                                                            <td class="text-end">@occ.EstimatedAmount.ToString("C")</td>
                                                            <td class="text-end">@(occ.ActualAmount?.ToString("C") ?? "—")</td>
                                                            <td class="text-center">@OccurrenceStatusBadge(occ.Status)</td>
                                                            <td class="text-end text-nowrap">
                                                                @if (occ.Status is BillOccurrenceStatus.Estimated or BillOccurrenceStatus.Received)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditOccurrence(occ)">Edit</button>
                                                                }
                                                                @if (occ.Status == BillOccurrenceStatus.Received)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => AdvanceOccurrenceStatus(occ, BillOccurrenceStatus.Submitted)">📤 Submit</button>
                                                                }
                                                                @if (occ.Status == BillOccurrenceStatus.Submitted)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-success me-1" @onclick="() => AdvanceOccurrenceStatus(occ, BillOccurrenceStatus.Confirmed)">✓ Confirm</button>
                                                                }
                                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _deletingOccurrence = occ">✕</button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    @if (autoDraftBills.Count > 0)
    {
        <h5 class="mt-2 mb-2">
            <span class="badge bg-info text-dark me-1">Auto-Draft</span>
            Bills pulled automatically
        </h5>
        <div class="table-responsive mb-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th></th><th>Name</th><th>Category</th><th>Frequency</th>
                        <th class="text-end">Est. Amount</th><th class="text-center">Next Due</th>
                        <th>Bank Account</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in autoDraftBills)
                    {
                        var today   = DateOnly.FromDateTime(DateTime.Today);
                        var nextDue = bill.UpcomingDueDate(today);
                        var dueSoon = nextDue <= today.AddDays(14);
                        <tr class="@(!bill.IsActive ? "text-muted" : "")">
                            <td class="text-center" style="width:28px">
                                <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleExpand(bill.Id)">
                                    @(_expanded.Contains(bill.Id) ? "▲" : "▼")
                                </button>
                            </td>
                            <td class="fw-semibold">
                                @bill.Name
                                @if (!bill.IsActive) { <span class="badge bg-secondary ms-1">Inactive</span> }
                            </td>
                            <td><span class="badge bg-light text-dark border">@bill.Category</span></td>
                            <td>@FrequencyLabel(bill.Frequency)</td>
                            <td class="text-end">@bill.Amount.ToString("C")</td>
                            <td class="text-center @(dueSoon ? "fw-semibold text-danger" : "")">@nextDue.ToString("MMM d, yyyy")</td>
                            <td class="text-muted small">@(bill.BankAccountName ?? "—")</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEnterActual(bill)"
                                        title="Record the amount actually drafted">
                                    Record Amount
                                </button>
                                @if (bill.BankAccountId.HasValue)
                                {
                                    <a class="btn btn-sm btn-link p-0 me-1 text-muted" href="/transactions/@Sqids.Encode(bill.BankAccountId!.Value)">View →</a>
                                }
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditBill(bill)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(bill)">Delete</button>
                            </td>
                        </tr>
                        @if (_expanded.Contains(bill.Id))
                        {
                            <tr>
                                <td colspan="8" class="p-0 border-top-0">
                                    <div class="bg-light px-4 py-2">
                                        @if (!_occurrences.TryGetValue(bill.Id, out var occs) || occs.Count == 0)
                                        {
                                            <span class="text-muted small fst-italic">No recorded history yet.</span>
                                        }
                                        else
                                        {
                                            <table class="table table-sm mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Due Date</th>
                                                        <th class="text-end">Estimated</th><th class="text-end">Actual</th>
                                                        <th class="text-center">Status</th><th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var occ in occs)
                                                    {
                                                        <tr>
                                                            <td>@occ.DueDate.ToString("MMM d, yyyy")</td>
                                                            <td class="text-end">@occ.EstimatedAmount.ToString("C")</td>
                                                            <td class="text-end">@(occ.ActualAmount?.ToString("C") ?? "—")</td>
                                                            <td class="text-center">@OccurrenceStatusBadge(occ.Status)</td>
                                                            <td class="text-end text-nowrap">
                                                                @if (occ.Status is BillOccurrenceStatus.Estimated or BillOccurrenceStatus.Received)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditOccurrence(occ)">Edit</button>
                                                                }
                                                                @if (occ.Status == BillOccurrenceStatus.Received)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => AdvanceOccurrenceStatus(occ, BillOccurrenceStatus.Submitted)">📤 Submit</button>
                                                                }
                                                                @if (occ.Status == BillOccurrenceStatus.Submitted)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-success me-1" @onclick="() => AdvanceOccurrenceStatus(occ, BillOccurrenceStatus.Confirmed)">✓ Confirm</button>
                                                                }
                                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _deletingOccurrence = occ">✕</button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

<!-- ── Add / Edit Bill Modal ──────────────────────────────────────── -->
@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editing.Id == 0 ? "Add Bill" : "Edit Bill")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (_modalError is not null)
                    {
                        <div class="alert alert-danger">@_modalError</div>
                    }
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Name</label>
                            <input class="form-control" @bind="_editing.Name" placeholder="e.g. Electric Bill" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Category</label>
                            <select class="form-select" @bind="_editing.Category">
                                @foreach (BillCategory cat in Enum.GetValues<BillCategory>())
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Estimated Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input class="form-control" type="number" step="0.01" min="0"
                                       @bind="_editing.Amount" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Frequency</label>
                            <select class="form-select" @bind="_editing.Frequency">
                                @foreach (BillFrequency freq in Enum.GetValues<BillFrequency>())
                                {
                                    <option value="@freq">@FrequencyLabel(freq)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                Next Due Date
                                <span class="text-muted small">
                                    @(_editing.Frequency is BillFrequency.Weekly or BillFrequency.BiWeekly
                                        ? "(day of week is derived from this date)"
                                        : "(day" + (_editing.Frequency == BillFrequency.Annual ? " &amp; month" : "") + " derived from this date)")
                                </span>
                            </label>
                            <input class="form-control" type="date" @bind="_nextDueDate" @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Payment Method</label>
                            <select class="form-select" @bind="_editing.PaymentMethod">
                                <option value="@DebtPaymentMethod.Manual">Manual</option>
                                <option value="@DebtPaymentMethod.AutoDraft">Auto-Draft</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Bank Account <span class="text-muted">(optional)</span></label>
                            <select class="form-select" @bind="_bankIdStr">
                                <option value="">— None —</option>
                                @foreach (var acct in _bankAccounts)
                                {
                                    <option value="@acct.Id">@acct.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes <span class="text-muted">(optional)</span></label>
                            <textarea class="form-control" rows="2" @bind="_editing.Notes"></textarea>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" id="isActive" @bind="_editing.IsActive" />
                                <label class="form-check-label" for="isActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveBill">Save</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Add Bill / Record Amount Modal ──────────────────────────────── -->
@if (_showActualModal)
{
    var isOneOff = _editingOcc?.IsOneOff ?? false;
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @if (isOneOff)
                        { <span>One-Off Bill</span> }
                        else
                        { <span>Record Amount — @_editingOcc?.DisplayName</span> }
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseActualModal"></button>
                </div>
                <div class="modal-body">
                    @if (_occModalError is not null)
                    {
                        <div class="alert alert-danger">@_occModalError</div>
                    }
                    <div class="row g-3">
                        @if (isOneOff)
                        {
                            <div class="col-12">
                                <label class="form-label">Bill Name</label>
                                <input class="form-control" type="text" @bind="_editingOcc!.Name" placeholder="e.g. Plumber invoice, Medical bill…" />
                            </div>
                        }
                        <div class="col-md-6">
                            <label class="form-label">Due Date</label>
                            <input class="form-control" type="date" @bind="_occDueDate" @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                Plan to Pay
                                <span class="text-muted small">(optional)</span>
                            </label>
                            <input class="form-control" type="date" @bind="_occPlannedPayDate" @bind:format="yyyy-MM-dd" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Actual Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input class="form-control" type="number" step="0.01" min="0"
                                       @bind="_occActualAmount" />
                            </div>
                        </div>
                        @if (!isOneOff)
                        {
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="occIsOneOff" @bind="_occIsOneOff" />
                                    <label class="form-check-label" for="occIsOneOff">
                                        One-off — don't update the estimated amount for future bills
                                    </label>
                                </div>
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label">Notes <span class="text-muted">(optional)</span></label>
                            <textarea class="form-control" rows="2" @bind="_editingOcc!.Notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseActualModal">Cancel</button>
                    <button class="btn btn-success" @onclick="SaveOccurrence">
                        @(isOneOff ? "Save One-Off Bill" : "Save Amount")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Delete Confirm Modal ───────────────────────────────────────── -->
@if (_deletingBill is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Bill?</h5>
                    <button type="button" class="btn-close" @onclick="() => _deletingBill = null"></button>
                </div>
                <div class="modal-body">
                    <p>Delete <strong>@_deletingBill.Name</strong>? Its recorded occurrence history is removed either way.</p>
                    <p class="text-muted small mb-0">
                        What should happen to its <strong>upcoming</strong> transactions on the Transactions page?
                    </p>
                </div>
                <div class="modal-footer flex-column align-items-stretch gap-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="() => DeleteBillConfirmed(deleteFutureTransactions: true)">
                        Delete them too
                    </button>
                    <button class="btn btn-outline-primary w-100" @onclick="() => DeleteBillConfirmed(deleteFutureTransactions: false)">
                        Keep them (as standalone manual transactions)
                    </button>
                    <button class="btn btn-secondary w-100" @onclick="() => _deletingBill = null">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Delete Occurrence Confirm Modal ──────────────────────────────── -->
@if (_addToFlowOcc is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add to cash flow – @_addToFlowOcc.DisplayName</h5>
                    <button type="button" class="btn-close" @onclick="() => _addToFlowOcc = null"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">
                        Schedules this bill as a pending payment in the account below. Submitting, clearing or skipping it there
                        updates this bill too.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Pay from</label>
                        <select class="form-select" @bind="_addToFlowAccountId">
                            <option value="0">— Choose an account —</option>
                            @foreach (var acct in _bankAccounts)
                            {
                                <option value="@acct.Id">@acct.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col">
                            <label class="form-label">Pay date</label>
                            <input type="date" class="form-control" @bind="_addToFlowDate" />
                            <div class="form-text">Due @_addToFlowOcc.DueDate.ToString("MMM d, yyyy")</div>
                        </div>
                        <div class="col">
                            <label class="form-label">Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" min="0" class="form-control" @bind="_addToFlowAmount" />
                            </div>
                        </div>
                    </div>
                    @if (_addToFlowError is not null)
                    {
                        <div class="alert alert-danger small mt-3 mb-0">@_addToFlowError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _addToFlowOcc = null">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveAddToCashFlow">Add to cash flow</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_deletingOccurrence is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Occurrence?</h5>
                    <button type="button" class="btn-close" @onclick="() => _deletingOccurrence = null"></button>
                </div>
                <div class="modal-body">
                    Delete the <strong>@_deletingOccurrence.DisplayName</strong> entry for
                    <strong>@_deletingOccurrence.DueDate.ToString("MMM d, yyyy")</strong>?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _deletingOccurrence = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteOccurrence">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Bill> _bills = [];
    private List<BankAccount> _bankAccounts = [];
    private List<BillOccurrence> _openOccurrences = [];
    // Open occurrences whose cash-flow transaction is gone (cleared/skipped on the Transactions page) — flagged so they can be closed out.
    private HashSet<int> _openMissingCashFlow = [];
    private bool _checkingCashFlow;
    private BillSyncResult? _syncResult;
    private HashSet<int> _expanded = [];
    private Dictionary<int, List<BillOccurrence>> _occurrences = [];
    private string _billSort = "date";   // "date" | "name"

    // Bill modal
    private bool _showModal;
    private Bill _editing = new();
    private string _bankIdStr = string.Empty;
    private string _annualMonthStr = string.Empty;
    private DateOnly _nextDueDate;   // date picker for DayDue / AnnualMonth
    private string? _modalError;

    // Occurrence (actual) modal
    private bool _showActualModal;
    private BillOccurrence? _editingOcc;
    private Bill? _enteringActualBill;      // the parent bill, needed to check PaymentMethod
    private DateOnly _occDueDate;
    private DateOnly? _occPlannedPayDate;
    private decimal _occActualAmount;
    private bool _occIsOneOff;              // when true, skip updating the bill estimate
    private string? _occModalError;

    // Delete
    private Bill? _deletingBill;
    private BillOccurrence? _deletingOccurrence;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user is null) return;
        _bills = (await BillRepo.GetAllAsync(user.Id, activeOnly: false)).ToList();
        _bankAccounts = (await AccountRepo.GetAllAsync(user.Id)).ToList();
        await LoadOpenOccurrencesAsync(user.Id);
    }

    private async Task LoadOpenOccurrencesAsync(int userId)
    {
        _openOccurrences = (await BillRepo.GetOpenOccurrencesAsync(userId)).ToList();
        _openMissingCashFlow = [.. await BillRepo.GetOpenOccurrenceIdsMissingCashFlowAsync(userId)];
    }

    private async Task ToggleExpand(int billId)
    {
        if (_expanded.Contains(billId))
        {
            _expanded.Remove(billId);
            return;
        }
        _expanded.Add(billId);
        if (!_occurrences.ContainsKey(billId))
            await LoadOccurrences(billId);
    }

    private async Task LoadOccurrences(int billId)
    {
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user is null) return;
        _occurrences[billId] = (await BillRepo.GetOccurrencesAsync(billId, user.Id)).ToList();
    }

    // ── Bill Modal ──────────────────────────────────────────────────

    private void OpenAddBill()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _editing = new Bill { IsActive = true, Frequency = BillFrequency.Monthly, DayDue = today.Day };
        _bankIdStr = string.Empty;
        _annualMonthStr = string.Empty;
        _nextDueDate = today;
        _modalError = null;
        _showModal = true;
    }

    private void OpenEditBill(Bill bill)
    {
        _editing = new Bill
        {
            Id = bill.Id, UserId = bill.UserId, Name = bill.Name, Amount = bill.Amount,
            Frequency = bill.Frequency, DayDue = bill.DayDue, AnnualMonth = bill.AnnualMonth,
            Category = bill.Category, PaymentMethod = bill.PaymentMethod,
            BankAccountId = bill.BankAccountId, Notes = bill.Notes, IsActive = bill.IsActive
        };
        _bankIdStr = bill.BankAccountId?.ToString() ?? string.Empty;
        _annualMonthStr = bill.AnnualMonth?.ToString() ?? string.Empty;
        var today = DateOnly.FromDateTime(DateTime.Today);
        var nextDue = bill.UpcomingDueDate(today);
        _nextDueDate = nextDue;
        _modalError = null;
        _showModal = true;
    }

    private void CloseModal() { _showModal = false; _modalError = null; }

    private async Task SaveBill()
    {
        if (string.IsNullOrWhiteSpace(_editing.Name)) { _modalError = "Name is required."; return; }
        if (_editing.Amount < 0) { _modalError = "Amount must be 0 or greater."; return; }

        _editing.BankAccountId = int.TryParse(_bankIdStr, out var bid) ? bid : null;

        // Derive DayDue (and AnnualMonth) from the date picker
        _editing.DayDue = _editing.Frequency is BillFrequency.Weekly or BillFrequency.BiWeekly
            ? (int)_nextDueDate.DayOfWeek
            : _nextDueDate.Day;
        _editing.AnnualMonth = _editing.Frequency == BillFrequency.Annual ? _nextDueDate.Month : null;

        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user is null) return;
        _editing.UserId = user.Id;

        if (_editing.Id == 0)
            _editing.Id = await BillRepo.CreateAsync(_editing);
        else
            await BillRepo.UpdateAsync(_editing);

        CloseModal();
        await LoadAsync();

        // Bring the bill's projected cash-flow entries in line with its (possibly changed) schedule, account and amount
        var saved = _bills.FirstOrDefault(b => b.Id == _editing.Id);
        if (saved is not null)
            await SyncSvc.SyncAsync(saved, user.Id);
    }

    // ── Delete ──────────────────────────────────────────────────────

    private void ConfirmDelete(Bill bill) { _deletingBill = bill; }

    private async Task DeleteBillConfirmed(bool deleteFutureTransactions)
    {
        if (_deletingBill is null) return;
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user is null) return;

        // Resolve the bill's still-upcoming Transactions-page entries before the bill itself is gone —
        // either drop them with it, or detach + keep them as standalone manual entries.
        if (deleteFutureTransactions)
            await CashFlowRepo.DeleteAllProjectedForSourceAsync(_deletingBill.Id, user.Id, TransactionCategory.Bill);
        else
            await CashFlowRepo.DetachSourceKeepAsManualAsync(_deletingBill.Id, user.Id, TransactionCategory.Bill);

        await BillRepo.DeleteAsync(_deletingBill.Id, user.Id);
        _occurrences.Remove(_deletingBill.Id);
        _expanded.Remove(_deletingBill.Id);
        _deletingBill = null;
        await LoadAsync();
    }

    // ── Occurrence Modal ────────────────────────────────────────────

    private void OpenEnterActual(Bill bill)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var nextDue = bill.UpcomingDueDate(today);
        _editingOcc = new BillOccurrence
        {
            BillId = bill.Id,
            BillName = bill.Name,
            EstimatedAmount = bill.Amount,
            Status = BillOccurrenceStatus.Received,
            DueDate = nextDue
        };
        _enteringActualBill = bill;
        _occDueDate = _editingOcc.DueDate;
        _occPlannedPayDate = null;
        _occActualAmount = bill.Amount;
        _occIsOneOff = false;
        _occModalError = null;
        _showActualModal = true;
    }

    private void OpenEditOccurrence(BillOccurrence occ)
    {
        _editingOcc = new BillOccurrence
        {
            Id = occ.Id, BillId = occ.BillId, UserId = occ.UserId, BillName = occ.BillName,
            DueDate = occ.DueDate, EstimatedAmount = occ.EstimatedAmount,
            ActualAmount = occ.ActualAmount, Status = occ.Status,
            SubmittedDate = occ.SubmittedDate, Notes = occ.Notes
        };
        _enteringActualBill = _bills.FirstOrDefault(b => b.Id == occ.BillId);
        _occDueDate = occ.DueDate;
        _occPlannedPayDate = occ.PlannedPayDate;
        _occActualAmount = occ.ActualAmount ?? occ.EstimatedAmount;
        _occIsOneOff = false;
        _occModalError = null;
        _showActualModal = true;
    }

    private void CloseActualModal() { _showActualModal = false; _editingOcc = null; _enteringActualBill = null; _occPlannedPayDate = null; _occIsOneOff = false; _occModalError = null; }

    private void OpenOneOffEntry()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _editingOcc = new BillOccurrence
        {
            BillId = null,
            EstimatedAmount = 0,
            Status = BillOccurrenceStatus.Received,
            DueDate = today
        };
        _enteringActualBill = null;
        _occDueDate = today;
        _occPlannedPayDate = null;
        _occActualAmount = 0;
        _occIsOneOff = false;
        _occModalError = null;
        _showActualModal = true;
    }

    private async Task SaveOccurrence()
    {
        if (_editingOcc is null) return;

        // Validate one-off name
        if (_editingOcc.IsOneOff && string.IsNullOrWhiteSpace(_editingOcc.Name))
        {
            _occModalError = "Please enter a name for the one-off bill.";
            return;
        }

        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user is null) return;

        bool isNewOccurrence = _editingOcc.Id == 0;

        _editingOcc.UserId = user.Id;
        _editingOcc.DueDate = _occDueDate;
        _editingOcc.PlannedPayDate = _occPlannedPayDate;
        _editingOcc.ActualAmount = _occActualAmount > 0 ? _occActualAmount : null;
        if (_editingOcc.IsOneOff)
            _editingOcc.EstimatedAmount = _occActualAmount;
        if (_editingOcc.Status == BillOccurrenceStatus.Estimated)
            _editingOcc.Status = BillOccurrenceStatus.Received;

        if (isNewOccurrence)
            await BillRepo.CreateOccurrenceAsync(_editingOcc);
        else
            await BillRepo.UpdateOccurrenceAsync(_editingOcc);

        // When an actual amount is recorded, update the bill's estimated amount and ripple to future projected transactions
        if (!_occIsOneOff && _enteringActualBill is { } bill && _occActualAmount > 0 && _occActualAmount != bill.Amount)
        {
            bill.Amount = _occActualAmount;
            await BillRepo.UpdateAsync(bill);
            // Update all future projected cash flow transactions for this bill
            await CashFlowRepo.UpdateProjectedAmountsAsync(bill.Id, user.Id, TransactionCategory.Bill, -_occActualAmount, _occDueDate.AddDays(1));
        }

        // Delete any projected entries for this bill on or before the recorded due date — they're now actuals
        if (!_editingOcc.IsOneOff && _enteringActualBill is { } sourceBill)
        {
            await CashFlowRepo.DeleteProjectedForSourceUpToDateAsync(sourceBill.Id, user.Id, TransactionCategory.Bill, _occDueDate);
        }

        // Insert a cash flow transaction for the actual payment so it shows in the bank account.
        // Use IsManualOverride = true (via InsertScheduledPaymentAsync) so future bill edits/pushes don't wipe it out.
        if (isNewOccurrence && !_editingOcc.IsOneOff && _enteringActualBill is { BankAccountId: not null } txBill)
        {
            var txAmount = _occActualAmount > 0 ? _occActualAmount : txBill.Amount;
            if (txAmount > 0)
            {
                var payDate = _occPlannedPayDate ?? _occDueDate;
                await CashFlowRepo.InsertScheduledPaymentAsync(new CashFlowTransaction
                {
                    UserId = user.Id,
                    BankAccountId = txBill.BankAccountId!.Value,
                    TransactionDate = payDate,
                    Description = $"Bill: {txBill.Name}",
                    Amount = -txAmount,
                    Category = TransactionCategory.Bill,
                    ReferenceId = txBill.Id,
                    IsProjected = true,
                    IsAutoDraft = txBill.PaymentMethod == DebtPaymentMethod.AutoDraft,
                    IsSubmitted = _editingOcc.Status == BillOccurrenceStatus.Submitted
                });
            }
        }

        // Auto-push the next occurrence to the cash flow if the bill has a bank account and it isn't there yet
        if (isNewOccurrence && _enteringActualBill is { BankAccountId: not null } pushedBill)
        {
            var nextDue = pushedBill.NextDueDate(pushedBill.NextFromAfterOccurrence(_occDueDate));
            var alreadyExists = await CashFlowRepo.HasProjectedForSourceOnDateAsync(pushedBill.Id, user.Id, TransactionCategory.Bill, nextDue);
            if (!alreadyExists)
            {
                await CashFlowRepo.BulkInsertProjectedAsync([new CashFlowTransaction
                {
                    UserId = user.Id,
                    BankAccountId = pushedBill.BankAccountId!.Value,
                    TransactionDate = nextDue,
                    Description = $"Bill: {pushedBill.Name}",
                    Amount = -(pushedBill.Amount),
                    Category = TransactionCategory.Bill,
                    ReferenceId = pushedBill.Id,
                    IsProjected = true,
                    IsAutoDraft = pushedBill.PaymentMethod == DebtPaymentMethod.AutoDraft
                }]);
            }
        }

        if (_editingOcc.BillId.HasValue)
        {
            _occurrences.Remove(_editingOcc.BillId.Value);
            if (_expanded.Contains(_editingOcc.BillId.Value))
                await LoadOccurrences(_editingOcc.BillId.Value);
        }

        // Always reload so the next due date and open bills list reflects the new occurrence
        await LoadAsync();
        CloseActualModal();
    }

    private async Task AdvanceOccurrenceStatus(BillOccurrence occ, BillOccurrenceStatus newStatus)
    {
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user is null) return;
        occ.Status = newStatus;
        // Audit stamp only — records when the user notified the vendor. It does NOT move the cash-flow
        // entry: the payment still lands on its planned pay date / due date.
        if (newStatus == BillOccurrenceStatus.Submitted)
            occ.SubmittedDate = DateOnly.FromDateTime(DateTime.Today);
        await BillRepo.UpdateOccurrenceAsync(occ);
        // Keep the CF transaction in sync with the bill occurrence status
        if (occ.BillId.HasValue && !occ.IsOneOff)
        {
            var payDate = occ.PlannedPayDate ?? occ.DueDate;
            if (newStatus == BillOccurrenceStatus.Submitted)
                await CashFlowRepo.MarkSubmittedForSourceOnDateAsync(occ.BillId.Value, user.Id, TransactionCategory.Bill, payDate);
        }
        if (newStatus == BillOccurrenceStatus.Submitted)
            await CashFlowRepo.SetSubmittedForOccurrenceAsync(occ.Id, user.Id, submitted: true);
        if (occ.BillId.HasValue)
        {
            _occurrences.Remove(occ.BillId.Value);
            await LoadOccurrences(occ.BillId.Value);
        }
        await LoadOpenOccurrencesAsync(user.Id);
    }

    private async Task ConfirmDeleteOccurrence()
    {
        if (_deletingOccurrence is null) return;
        var occ = _deletingOccurrence;
        _deletingOccurrence = null;
        await DeleteOccurrence(occ);
    }

    private async Task DeleteOccurrence(BillOccurrence occ)
    {
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user is null) return;
        await BillRepo.DeleteOccurrenceAsync(occ.Id, user.Id);
        await CashFlowRepo.DeleteForOccurrenceAsync(occ.Id, user.Id);
        // Delete the corresponding CF transaction that was inserted when this occurrence was recorded
        if (occ.BillId.HasValue && !occ.IsOneOff)
        {
            var payDate = occ.PlannedPayDate ?? occ.DueDate;
            await CashFlowRepo.DeleteManualProjectedOnDateAsync(occ.BillId.Value, user.Id, TransactionCategory.Bill, payDate);
        }
        if (occ.BillId.HasValue)
        {
            _occurrences.Remove(occ.BillId.Value);
            await LoadOccurrences(occ.BillId.Value);
        }
        await LoadOpenOccurrencesAsync(user.Id);
    }

    // ── Add an open bill to cash flow ───────────────────────────────

    private BillOccurrence? _addToFlowOcc;
    private int _addToFlowAccountId;
    private DateOnly _addToFlowDate;
    private decimal _addToFlowAmount;
    private string? _addToFlowError;

    private void OpenAddToCashFlow(BillOccurrence occ)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var bill = _bills.FirstOrDefault(b => b.Id == occ.BillId);
        _addToFlowOcc = occ;
        _addToFlowAccountId = bill?.BankAccountId ?? 0;
        // An overdue bill still has to be paid — default to today rather than a date already gone.
        var payDate = occ.PlannedPayDate ?? occ.DueDate;
        _addToFlowDate = payDate < today ? today : payDate;
        _addToFlowAmount = occ.ActualAmount ?? occ.EstimatedAmount;
        _addToFlowError = null;
    }

    private async Task SaveAddToCashFlow()
    {
        if (_addToFlowOcc is null) return;
        if (_addToFlowAccountId == 0) { _addToFlowError = "Choose the account it will be paid from."; return; }
        if (_addToFlowAmount <= 0) { _addToFlowError = "Enter the amount to pay."; return; }
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user is null) return;

        await BillPaymentSvc.AddToCashFlowAsync(_addToFlowOcc, _addToFlowAccountId, _addToFlowDate, _addToFlowAmount, user.Id);
        _addToFlowOcc = null;
        await LoadOpenOccurrencesAsync(user.Id);
    }

    // ── Check Cash Flow ─────────────────────────────────────────────

    private async Task CheckCashFlowAsync()
    {
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user is null) return;
        _checkingCashFlow = true;
        _syncResult = null;
        try
        {
            _syncResult = await SyncSvc.SyncAllAsync(user.Id);
            await LoadAsync();
        }
        finally
        {
            _checkingCashFlow = false;
        }
    }

    // ── Helpers ─────────────────────────────────────────────────────

    private static string FrequencyLabel(BillFrequency freq) => freq switch
    {
        BillFrequency.Weekly     => "Weekly",
        BillFrequency.BiWeekly   => "Every 2 Weeks",
        BillFrequency.Monthly    => "Monthly",
        BillFrequency.BiMonthly  => "Every 2 Months",
        BillFrequency.Quarterly  => "Quarterly",
        BillFrequency.SemiAnnual => "Semi-Annual",
        BillFrequency.Annual     => "Annual",
        _                        => freq.ToString()
    };

    private static MarkupString OccurrenceStatusBadge(BillOccurrenceStatus status) => status switch
    {
        BillOccurrenceStatus.Estimated => new("<span class=\"badge bg-secondary\">Estimated</span>"),
        BillOccurrenceStatus.Received  => new("<span class=\"badge bg-primary\">Received</span>"),
        BillOccurrenceStatus.Submitted => new("<span class=\"badge bg-warning text-dark\">Submitted</span>"),
        BillOccurrenceStatus.Confirmed => new("<span class=\"badge bg-success\">Confirmed</span>"),
        _                              => new(status.ToString())
    };
}
