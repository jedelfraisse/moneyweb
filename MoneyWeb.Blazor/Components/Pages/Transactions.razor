@page "/transactions/{BankAccountId}"
@rendermode InteractiveServer
@using MoneyWeb.Blazor.Services
@using MoneyWeb.Data.Models
@using MoneyWeb.Data.Repositories.Interfaces
@attribute [Authorize]
@inject CurrentUserService CurrentUserService
@inject IBankAccountRepository AccountRepo
@inject ICashFlowRepository CashFlowRepo
@inject NavigationManager Nav
@inject SqidsEncoder<int> Sqids

<PageTitle>Cash Flow – MoneyWeb</PageTitle>

@if (_loading)
{
    <p>Loading&hellip;</p>
}
else if (_account is null)
{
    <p class="text-danger">Account not found.</p>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/bank-accounts">Bank Accounts</a></li>
            <li class="breadcrumb-item active">@_account.Name – Cash Flow</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">@_account.Name <span class="text-muted fs-5">Cash Flow</span> <PageInfoPopover Title="Cash Flow" Content="Projects your account balance forward day by day — applying scheduled bills, debt payments, and incoming loan repayments. Use this forecast to spot low-balance gaps before they happen and decide the best time to make payments." /></h1>
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                @if (_editingBalance)
                {
                    <span class="text-muted small">Current balance:</span>
                    <div class="input-group input-group-sm" style="width:160px">
                        <span class="input-group-text">$</span>
                        <input class="form-control" type="number" step="0.01"
                               @bind="_newBalance" @bind:event="oninput" />
                    </div>
                    <button class="btn btn-sm btn-success" @onclick="SaveBalance">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _editingBalance = false">✕</button>
                }
                else
                {
                    <span class="text-muted small">Current balance:</span>
                    <span class="fw-bold fs-5">@_account.CurrentBalance.ToString("C")</span>
                    <button class="btn btn-sm btn-outline-secondary" title="Update current balance"
                            @onclick="BeginEditBalance">✏️</button>
                }
            </div>
            <button class="btn btn-primary" @onclick="OpenAddModal">+ Add Transaction</button>
        </div>
    </div>

    @if (!_months.Any())
    {
        <div class="alert alert-info">
            No transactions yet. Add one manually or assign a bank account to a debt group and push from the Debts page.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Running Balance</th>
                        <th class="text-center">Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var month in _months)
                    {
                        <tr class="table-dark text-white">
                            <td colspan="6" class="fw-bold">@month.Label</td>
                        </tr>
                        @foreach (var row in month.Rows)
                        {
                            var t = row.Transaction;
                            var rowClass = (!t.IsProjected) ? "" :
                                          t.IsSubmitted ? "table-info" :
                                          t.IsManualOverride ? "table-warning" : "";
                            <tr class="@rowClass">
                                <td class="text-nowrap">
                                    @t.TransactionDate.ToString("MMM d, yyyy")
                                </td>
                                <td>@t.Description</td>
                                <td class="text-end fw-semibold @(t.Amount >= 0 ? "text-success" : "text-danger")">
                                    @t.Amount.ToString("C")
                                </td>
                                <td class="text-end @(row.RunningBalance < 0 ? "text-danger fw-bold" : "")">
                                    @row.RunningBalance.ToString("C")
                                </td>
                                <td class="text-center">
                                    @if (!t.IsProjected)
                                    {
                                        <span class="badge bg-success">✅ Confirmed</span>
                                    }
                                    else if (t.TransactionDate < DateOnly.FromDateTime(DateTime.Today))
                                    {
                                        <span class="badge bg-danger" title="Projected date has passed — confirm or skip">⚠️ Overdue</span>
                                    }
                                    else if (t.IsSubmitted && t.IsAutoDraft)
                                    {
                                        <span class="badge bg-info text-dark">Auto-Draft – Submitted</span>
                                    }
                                    else if (t.IsSubmitted)
                                    {
                                        <span class="badge bg-warning text-dark" title="Payment submitted to vendor — awaiting clearance">📤 Submitted – Pending</span>
                                    }
                                    else if (t.IsAutoDraft)
                                    {
                                        <span class="badge bg-info text-dark" title="Vendor pulls automatically — date is fixed">Auto-Draft</span>
                                    }
                                    else if (t.IsManualOverride)
                                    {
                                        <span class="badge bg-warning text-dark">Manual – Custom Date</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Projected</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @if (t.IsProjected)
                                    {
                                        @if (_submittingId == t.Id)
                                        {
                                            <span class="me-1 text-muted small">Submitted on:</span>
                                            <input type="date" class="form-control form-control-sm d-inline-block me-1" style="width:145px"
                                                   @bind="_submitDate" @bind:format="yyyy-MM-dd" />
                                            <button class="btn btn-sm btn-info me-1" @onclick="() => ConfirmSubmit(t)">Confirm</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelSubmit">Cancel</button>
                                        }
                                        else if (_changingDateId == t.Id)
                                        {
                                            <input type="date" class="form-control form-control-sm d-inline-block me-1" style="width:145px"
                                                   value="@t.TransactionDate.ToString("yyyy-MM-dd")"
                                                   @onchange="e => OverrideDate(t, e.Value?.ToString())" />
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _changingDateId = null">Cancel</button>
                                        }
                                        else
                                        {
                                            @if (!t.IsAutoDraft && !t.IsSubmitted)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary me-1" title="Change date"
                                                        @onclick="() => _changingDateId = t.Id">📅</button>
                                            }
                                            @if (!t.IsSubmitted)
                                            {
                                                <button class="btn btn-sm btn-outline-warning me-1" title="I told the vendor — record the submitted date"
                                                        @onclick="() => BeginSubmit(t.Id)">📤 Submit</button>
                                            }
                                            <button class="btn btn-sm btn-outline-success me-1" title="Payment cleared/confirmed"
                                                    @onclick="() => MarkProcessed(t)">✓</button>
                                            <button class="btn btn-sm btn-outline-danger" title="Skip / remove this projected entry"
                                                    @onclick="() => SkipTransaction(t)">Skip</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                        <tr class="table-secondary text-muted small">
                            <td colspan="2" class="ps-3">@month.Label net</td>
                            <td class="text-end fw-semibold @(month.Subtotal >= 0 ? "text-success" : "text-danger")">
                                @month.Subtotal.ToString("C")
                            </td>
                            <td colspan="3"></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold table-light">
                        <td colspan="2">Projected balance after all transactions</td>
                        <td colspan="2" class="text-end @(_finalBalance < 0 ? "text-danger" : "")">
                            @_finalBalance.ToString("C")
                        </td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
}

@* ── Add Manual Transaction Modal ── *@
@if (_showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Transaction</h5>
                    <button class="btn-close" @onclick="CloseAddModal"></button>
                </div>
                <div class="modal-body">
                    @if (_addError is not null)
                    {
                        <div class="alert alert-danger">@_addError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input class="form-control" type="date" @bind="_newDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <input class="form-control" type="text" @bind="_newDesc" placeholder="e.g. Electric bill, Grocery run…" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" id="typePayment" name="txType"
                                   checked="@(!_newIsDeposit)" @onchange="() => _newIsDeposit = false" />
                            <label class="btn btn-outline-danger" for="typePayment">💸 Payment (outflow)</label>
                            <input type="radio" class="btn-check" id="typeDeposit" name="txType"
                                   checked="@_newIsDeposit" @onchange="() => _newIsDeposit = true" />
                            <label class="btn btn-outline-success" for="typeDeposit">💰 Deposit (inflow)</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input class="form-control" type="number" step="0.01" min="0"
                                   @bind="_newAmount" placeholder="0.00" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseAddModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveManualTransaction">Add</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string BankAccountId { get; set; } = "";

    private int _bankAccountId;
    private bool _loading = true;
    private int _userId;
    private BankAccount? _account;
    private List<MonthGroup> _months = [];
    private decimal _finalBalance;
    private int? _changingDateId;

    // Balance editing
    private bool _editingBalance;
    private decimal _newBalance;

    // Submit flow
    private int? _submittingId;
    private DateOnly _submitDate;

    // Add manual transaction modal
    private bool _showAddModal;
    private string _newDesc = "";
    private decimal _newAmount;
    private DateOnly _newDate;
    private bool _newIsDeposit;
    private string? _addError;

    private record TransactionRow(CashFlowTransaction Transaction, decimal RunningBalance);
    private record MonthGroup(string Label, List<TransactionRow> Rows, decimal Subtotal);

    protected override async Task OnInitializedAsync()
    {
        _bankAccountId = Sqids.Decode(BankAccountId).FirstOrDefault();
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user?.IsApproved != true) { Nav.NavigateTo("/"); return; }
        _userId = user.Id;

        var accounts = await AccountRepo.GetAllAsync(_userId);
        _account = accounts.FirstOrDefault(a => a.Id == _bankAccountId);
        if (_account is null) { _loading = false; return; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Start from the beginning of the current month so past-pending items are visible
        var today = DateOnly.FromDateTime(DateTime.Today);
        var from = new DateOnly(today.Year, today.Month, 1);
        var to = today.AddMonths(60);
        var raw = (await CashFlowRepo.GetForAccountAsync(_bankAccountId, _userId, from, to))
            .OrderBy(t => t.TransactionDate).ThenBy(t => t.Id)
            .ToList();

        decimal running = _account!.CurrentBalance;
        _months = raw
            .GroupBy(t => new { t.TransactionDate.Year, t.TransactionDate.Month })
            .Select(g =>
            {
                var rows = g.Select(t => { running += t.Amount; return new TransactionRow(t, running); }).ToList();
                var subtotal = g.Sum(t => t.Amount);
                var label = new DateOnly(g.Key.Year, g.Key.Month, 1).ToString("MMMM yyyy");
                return new MonthGroup(label, rows, subtotal);
            })
            .ToList();

        _finalBalance = running;
        _changingDateId = null;
        _submittingId = null;
        _loading = false;
    }

    private async Task OverrideDate(CashFlowTransaction t, string? value)
    {
        if (!DateOnly.TryParse(value, out var newDate)) return;
        await CashFlowRepo.UpdateManualOverrideDateAsync(t.Id, _userId, newDate);
        _changingDateId = null;
        await LoadAsync();
    }

    private void BeginSubmit(int id)
    {
        _submittingId = id;
        _submitDate = DateOnly.FromDateTime(DateTime.Today);
        _changingDateId = null;
    }

    private void CancelSubmit() => _submittingId = null;

    private async Task ConfirmSubmit(CashFlowTransaction t)
    {
        await CashFlowRepo.MarkAsSubmittedAsync(t.Id, _userId, _submitDate);
        _submittingId = null;
        await LoadAsync();
    }

    private async Task MarkProcessed(CashFlowTransaction t)
    {
        await CashFlowRepo.MarkAsProcessedAsync(t.Id, _userId);
        await LoadAsync();
    }

    private async Task SkipTransaction(CashFlowTransaction t)
    {
        await CashFlowRepo.DeleteAsync(t.Id, _userId);
        await LoadAsync();
    }

    private void BeginEditBalance()
    {
        _newBalance = _account!.CurrentBalance;
        _editingBalance = true;
    }

    private async Task SaveBalance()
    {
        _account!.CurrentBalance = _newBalance;
        await AccountRepo.UpdateAsync(_account);
        _editingBalance = false;
        await LoadAsync();
    }

    private void OpenAddModal()
    {
        _newDesc = "";
        _newAmount = 0;
        _newDate = DateOnly.FromDateTime(DateTime.Today);
        _newIsDeposit = false;
        _addError = null;
        _showAddModal = true;
    }

    private void CloseAddModal() => _showAddModal = false;

    private async Task SaveManualTransaction()
    {
        if (string.IsNullOrWhiteSpace(_newDesc)) { _addError = "Description is required."; return; }
        if (_newAmount <= 0) { _addError = "Amount must be greater than zero."; return; }

        var t = new CashFlowTransaction
        {
            UserId = _userId,
            BankAccountId = _bankAccountId,
            TransactionDate = _newDate,
            Description = _newDesc.Trim(),
            Amount = _newIsDeposit ? _newAmount : -_newAmount,
            Category = TransactionCategory.Other,
            IsProjected = true
        };
        await CashFlowRepo.InsertManualAsync(t);
        _showAddModal = false;
        await LoadAsync();
    }
}

