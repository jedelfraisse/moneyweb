@page "/sinking-funds"
@rendermode InteractiveServer
@using MoneyWeb.Blazor.Services
@using MoneyWeb.Data.Models
@using MoneyWeb.Data.Repositories.Interfaces
@attribute [Authorize]
@inject CurrentUserService CurrentUserService
@inject ISinkingFundRepository SinkingFundRepo
@inject IBankAccountRepository AccountRepo
@inject ICashFlowRepository CashFlowRepo
@inject IUserRepository UserRepo

<PageTitle>Sinking Funds – MoneyWeb</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Sinking Funds <PageInfoPopover Title="Sinking Funds" Content="Set aside money regularly for predictable future expenses — car maintenance, insurance renewals, holiday spending. Pre-funding these buckets means the cash is ready when the bill arrives, so large expenses never catch you off guard." /></h1>
    <button class="btn btn-primary" @onclick="OpenAdd">Add Fund</button>
</div>

@if (_loading)
{
    <p>Loading&hellip;</p>
}
else
{
    @* ── Summary row ── *@
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">Total Reserved</div>
                    <div class="fs-4 fw-bold">@_funds.Sum(f => f.CurrentSaved).ToString("C")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">Monthly Contributions</div>
                    <div class="fs-4 fw-bold">@_funds.Where(f => f.IsActive).Sum(f => f.EffectiveMonthlyContribution).ToString("C")</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">Total Owed This Year</div>
                    <div class="fs-4 fw-bold">@_funds.Where(f => f.IsActive).Sum(f => f.TargetAmount).ToString("C")</div>
                </div>
            </div>
        </div>
    </div>

    @if (!_funds.Any())
    {
        <p class="text-muted">No sinking funds yet. Add one to get started.</p>
    }

    <div class="row g-3">
        @foreach (var fund in _funds)
        {
            var barColor = fund.PercentSaved >= 100 ? "bg-success"
                         : fund.IsOnTrack           ? "bg-warning"
                                                    : "bg-danger";
            <div class="col-12 col-lg-6">
                <div class="card h-100 @(fund.IsActive ? "" : "opacity-50")">
                    <div class="card-header d-flex align-items-center gap-2 flex-wrap">
                        <span class="fw-semibold me-auto">@fund.Name</span>
                        <span class="badge bg-secondary">@FormatFrequency(fund.Frequency)</span>
                        <span class="badge bg-info text-dark">@fund.NextDueDate.ToString("MMM d, yyyy")</span>
                        <div class="form-check form-switch mb-0" title="@(fund.IsActive ? "Active" : "Inactive")">
                            <input class="form-check-input" type="checkbox" checked="@fund.IsActive"
                                   @onchange="() => ToggleActive(fund)" />
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(fund)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _deleteTarget = fund">Delete</button>
                    </div>
                    <div class="card-body">
                        @* Progress bar *@
                        <div class="progress mb-3" style="height:18px">
                            <div class="progress-bar @barColor"
                                 role="progressbar"
                                 style="width:@(Math.Min(100, fund.PercentSaved))%"
                                 aria-valuenow="@fund.PercentSaved" aria-valuemin="0" aria-valuemax="100">
                                @if (fund.PercentSaved >= 10)
                                {
                                    <span>@fund.PercentSaved%</span>
                                }
                            </div>
                        </div>

                        @* Key stats *@
                        <div class="row row-cols-2 row-cols-sm-3 g-2 small mb-2">
                            <div class="col">
                                <div class="text-muted">Target</div>
                                <div class="fw-semibold">@fund.TargetAmount.ToString("C")</div>
                            </div>
                            <div class="col">
                                <div class="text-muted">Saved</div>
                                <div class="fw-semibold text-success">@fund.CurrentSaved.ToString("C")</div>
                            </div>
                            <div class="col">
                                <div class="text-muted">Still Needed</div>
                                <div class="fw-semibold">@fund.AmountNeeded.ToString("C")</div>
                            </div>
                            <div class="col">
                                <div class="text-muted">Monthly Needed</div>
                                <div class="fw-semibold">
                                    @fund.EffectiveMonthlyContribution.ToString("C")
                                    @if (fund.MonthlyContribution is null)
                                    {
                                        <span class="badge bg-secondary ms-1 fw-normal" style="font-size:.65rem">auto</span>
                                    }
                                </div>
                            </div>
                            <div class="col">
                                <div class="text-muted">Months Left</div>
                                <div class="fw-semibold">@fund.MonthsRemaining</div>
                            </div>
                            <div class="col">
                                <div class="text-muted">Savings Account</div>
                                <div class="fw-semibold text-truncate">@(fund.BankAccount?.Name ?? "—")</div>
                            </div>
                            @if (fund.FundingAccount is not null)
                            {
                                <div class="col">
                                    <div class="text-muted">Transfer From</div>
                                    <div class="fw-semibold text-truncate">@fund.FundingAccount.Name</div>
                                </div>
                            }
                        </div>

                        @* Status badge *@
                        @if (fund.PercentSaved >= 100)
                        {
                            <span class="badge bg-primary">Funded</span>
                        }
                        else if (fund.IsOnTrack)
                        {
                            <span class="badge bg-success">On Track</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Behind</span>
                        }

                        @if (!string.IsNullOrWhiteSpace(fund.Description))
                        {
                            <p class="text-muted small mt-2 mb-0">@fund.Description</p>
                        }
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <button class="btn btn-sm btn-outline-success" @onclick="() => OpenContribute(fund)">Contribute</button>
                        <button class="btn btn-sm btn-outline-warning" @onclick="() => OpenWithdraw(fund)">Withdraw</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _markPaidTarget = fund">Mark Paid</button>
                        @if (fund.BankAccountId.HasValue)
                        {
                            <button class="btn btn-sm btn-outline-info" @onclick="() => PushToFlow(fund)">Push to Cash Flow</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ── Add/Edit Modal ── *@
@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editing.Id == 0 ? "Add" : "Edit") Sinking Fund</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_editing.Name" placeholder="e.g. Property Tax" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label">Frequency</label>
                            <select class="form-select" @bind="_editing.Frequency">
                                <option value="@SinkingFundFrequency.Annual">Annual</option>
                                <option value="@SinkingFundFrequency.SemiAnnual">Semi-Annual</option>
                                <option value="@SinkingFundFrequency.Quarterly">Quarterly</option>
                                <option value="@SinkingFundFrequency.Monthly">Monthly</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <input class="form-control" @bind="_editing.Description" placeholder="Optional" />
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Target Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input class="form-control" type="number" step="0.01" @bind="_editing.TargetAmount" />
                            </div>
                        </div>
                        <div class="col">
                            <label class="form-label">Next Due Date</label>
                            <input class="form-control" type="date"
                                   value="@_editing.NextDueDate.ToString("yyyy-MM-dd")"
                                   @onchange="e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) _editing.NextDueDate = d; }" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">
                                Monthly Contribution
                                <span class="text-muted small">(leave blank to auto-calculate)</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input class="form-control" type="number" step="0.01"
                                       placeholder="@AutoContribPlaceholder"
                                       value="@_monthlyContribStr"
                                       @oninput="e => _monthlyContribStr = e.Value?.ToString() ?? string.Empty" />
                            </div>
                        </div>
                        <div class="col">
                            <label class="form-label">Savings Account <span class="text-muted small">(bucket lives here)</span></label>
                            <select class="form-select" value="@_bankIdStr"
                                    @onchange="e => _bankIdStr = e.Value?.ToString() ?? string.Empty">
                                <option value="">— None —</option>
                                @foreach (var acct in _bankAccounts)
                                {
                                    <option value="@acct.Id">@acct.Name (@acct.AccountType)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Transfer From <span class="text-muted small">(optional — source account for monthly contributions)</span></label>
                        <select class="form-select" value="@_fundingIdStr"
                                @onchange="e => _fundingIdStr = e.Value?.ToString() ?? string.Empty">
                            <option value="">— None (single-account bucket) —</option>
                            @foreach (var acct in _bankAccounts)
                            {
                                <option value="@acct.Id">@acct.Name (@acct.AccountType)</option>
                            }
                        </select>
                        @if (!string.IsNullOrEmpty(_fundingIdStr) && _fundingIdStr == _bankIdStr)
                        {
                            <div class="form-text text-warning">⚠️ Source and destination are the same account — contributions will show as a reservation, not a real transfer.</div>
                        }
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="chkFundActive" @bind="_editing.IsActive" />
                        <label class="form-check-label" for="chkFundActive">Active</label>
                    </div>
                    @if (_error is not null)
                    {
                        <div class="alert alert-danger">@_error</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="Save">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Contribute / Withdraw Modal ── *@
@if (_adjustTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_isWithdraw ? "Withdraw from" : "Contribute to") @_adjustTarget.Name</h5>
                    <button type="button" class="btn-close" @onclick="() => _adjustTarget = null"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input class="form-control" type="number" step="0.01" min="0.01"
                                   @bind="_adjustAmount" />
                        </div>
                    </div>
                    @if (_isWithdraw && _adjustAmount > 0)
                    {
                        var remainingAfter = _adjustTarget.AmountNeeded + _adjustAmount;
                        var monthsLeft = Math.Max(1, _adjustTarget.MonthsRemaining);
                        var newMonthly = Math.Ceiling(remainingAfter / monthsLeft * 100) / 100;
                        <div class="alert alert-warning small">
                            Withdrawing @_adjustAmount.ToString("C") means you'll need
                            <strong>@newMonthly.ToString("C")/month</strong> to stay on track.
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _adjustTarget = null">Cancel</button>
                    <button class="btn @(_isWithdraw ? "btn-warning" : "btn-success")"
                            @onclick="ConfirmAdjust">
                        @(_isWithdraw ? "Withdraw" : "Contribute")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Mark Paid Confirm ── *@
@if (_markPaidTarget is not null)
{
    var nextDate = _markPaidTarget.NextDueDate.AddMonths(_markPaidTarget.PeriodMonths);
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Mark Paid – @_markPaidTarget.Name</h5></div>
                <div class="modal-body">
                    <p>
                        This will reset the saved balance to <strong>$0</strong> and advance the due date to
                        <strong>@nextDate.ToString("MMM d, yyyy")</strong>.
                    </p>
                    <p class="text-muted small">Any projected sinking fund transactions for this fund will be cleared.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _markPaidTarget = null">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmMarkPaid">Confirm</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Delete Confirm ── *@
@if (_deleteTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Delete Sinking Fund</h5></div>
                <div class="modal-body">
                    <p>Delete <strong>@_deleteTarget.Name</strong>? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _deleteTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private int _userId;
    private int _horizonMonths = 12;
    private List<SinkingFund> _funds = [];
    private List<BankAccount> _bankAccounts = [];

    // Add/Edit modal
    private bool _showModal;
    private SinkingFund _editing = new();
    private string _bankIdStr = string.Empty;
    private string _fundingIdStr = string.Empty;
    private string _monthlyContribStr = string.Empty;
    private string? _error;

    // Contribute / Withdraw
    private SinkingFund? _adjustTarget;
    private decimal _adjustAmount;
    private bool _isWithdraw;

    // Mark Paid confirm
    private SinkingFund? _markPaidTarget;

    // Delete confirm
    private SinkingFund? _deleteTarget;

    private string AutoContribPlaceholder
    {
        get
        {
            if (_editing.TargetAmount <= 0 || _editing.NextDueDate == default) return "auto";
            var needed = Math.Max(0, _editing.TargetAmount - _editing.CurrentSaved);
            var months = Math.Max(1,
                ((_editing.NextDueDate.Year - DateOnly.FromDateTime(DateTime.Today).Year) * 12)
                + _editing.NextDueDate.Month - DateOnly.FromDateTime(DateTime.Today).Month);
            var auto = Math.Ceiling(needed / months * 100) / 100;
            return auto.ToString("C");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user?.IsApproved != true) return;
        _userId = user.Id;
        _horizonMonths = Math.Clamp(user.CashFlowHorizonMonths, 1, 60);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _bankAccounts = (await AccountRepo.GetAllAsync(_userId)).ToList();
        _funds = (await SinkingFundRepo.GetAllAsync(_userId, activeOnly: false)).ToList();
        _loading = false;
    }

    private void OpenAdd()
    {
        _editing = new SinkingFund
        {
            UserId = _userId,
            IsActive = true,
            NextDueDate = DateOnly.FromDateTime(DateTime.Today.AddYears(1))
        };
        _bankIdStr = string.Empty;
        _fundingIdStr = string.Empty;
        _monthlyContribStr = string.Empty;
        _error = null;
        _showModal = true;
    }

    private void OpenEdit(SinkingFund fund)
    {
        _editing = new SinkingFund
        {
            Id = fund.Id, UserId = fund.UserId,
            Name = fund.Name, Description = fund.Description,
            TargetAmount = fund.TargetAmount, Frequency = fund.Frequency,
            NextDueDate = fund.NextDueDate, MonthlyContribution = fund.MonthlyContribution,
            CurrentSaved = fund.CurrentSaved, BankAccountId = fund.BankAccountId,
            FundingAccountId = fund.FundingAccountId, IsActive = fund.IsActive
        };
        _bankIdStr = fund.BankAccountId.HasValue ? fund.BankAccountId.Value.ToString() : string.Empty;
        _fundingIdStr = fund.FundingAccountId.HasValue ? fund.FundingAccountId.Value.ToString() : string.Empty;
        _monthlyContribStr = fund.MonthlyContribution.HasValue
            ? fund.MonthlyContribution.Value.ToString("F2")
            : string.Empty;
        _error = null;
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_editing.Name)) { _error = "Name is required."; return; }
        if (_editing.TargetAmount <= 0) { _error = "Target amount must be greater than zero."; return; }
        if (_editing.NextDueDate == default) { _error = "Next due date is required."; return; }

        _editing.UserId = _userId;
        _editing.BankAccountId = int.TryParse(_bankIdStr, out var bid) ? bid : null;
        _editing.FundingAccountId = int.TryParse(_fundingIdStr, out var fid) ? fid : null;
        _editing.MonthlyContribution = decimal.TryParse(_monthlyContribStr, out var mc) && mc > 0 ? mc : null;

        if (_editing.Id == 0)
            await SinkingFundRepo.CreateAsync(_editing);
        else
            await SinkingFundRepo.UpdateAsync(_editing);

        _showModal = false;
        await LoadAsync();
    }

    private void OpenContribute(SinkingFund fund)
    {
        _adjustTarget = fund;
        _adjustAmount = 0;
        _isWithdraw = false;
    }

    private void OpenWithdraw(SinkingFund fund)
    {
        _adjustTarget = fund;
        _adjustAmount = 0;
        _isWithdraw = true;
    }

    private async Task ConfirmAdjust()
    {
        if (_adjustTarget is null || _adjustAmount <= 0) return;
        var delta = _isWithdraw ? -_adjustAmount : _adjustAmount;
        await SinkingFundRepo.AdjustSavedAsync(_adjustTarget.Id, _userId, delta);
        _adjustTarget = null;
        await LoadAsync();
    }

    private async Task ConfirmMarkPaid()
    {
        if (_markPaidTarget is null) return;
        await SinkingFundRepo.MarkPaidAndResetAsync(_markPaidTarget.Id, _userId);
        if (_markPaidTarget.BankAccountId.HasValue)
        {
            await CashFlowRepo.DeleteProjectedForSourceAsync(_markPaidTarget.Id, _userId, TransactionCategory.SinkingFundPayment);
            await CashFlowRepo.DeleteProjectedForSourceAsync(_markPaidTarget.Id, _userId, TransactionCategory.SinkingFundContribution);
        }
        _markPaidTarget = null;
        await LoadAsync();
    }

    private async Task ToggleActive(SinkingFund fund)
    {
        fund.IsActive = !fund.IsActive;
        await SinkingFundRepo.UpdateAsync(fund);
        await LoadAsync();
    }

    private async Task ConfirmDelete()
    {
        if (_deleteTarget is null) return;
        if (_deleteTarget.BankAccountId.HasValue)
        {
            await CashFlowRepo.DeleteProjectedForSourceAsync(_deleteTarget.Id, _userId, TransactionCategory.SinkingFundPayment);
            await CashFlowRepo.DeleteProjectedForSourceAsync(_deleteTarget.Id, _userId, TransactionCategory.SinkingFundContribution);
        }
        await SinkingFundRepo.DeleteAsync(_deleteTarget.Id, _userId);
        _deleteTarget = null;
        await LoadAsync();
    }

    private async Task PushToFlow(SinkingFund fund)
    {
        if (!fund.BankAccountId.HasValue) return;

        // Clear existing projections for this fund (both payment and contribution types)
        await CashFlowRepo.DeleteProjectedForSourceAsync(fund.Id, _userId, TransactionCategory.SinkingFundPayment);
        await CashFlowRepo.DeleteProjectedForSourceAsync(fund.Id, _userId, TransactionCategory.SinkingFundContribution);

        var transactions = new List<CashFlowTransaction>();
        var cutoff = DateOnly.FromDateTime(DateTime.Today.AddMonths(_horizonMonths));
        var today = DateOnly.FromDateTime(DateTime.Today);

        // Monthly contribution transfers within horizon
        var contribDate = today.AddMonths(1);  // start next month
        contribDate = new DateOnly(contribDate.Year, contribDate.Month, 1); // first of month
        while (contribDate <= cutoff && contribDate < fund.NextDueDate)
        {
            if (fund.FundingAccountId.HasValue)
            {
                // Outflow from funding (source) account
                transactions.Add(new CashFlowTransaction
                {
                    UserId = _userId,
                    BankAccountId = fund.FundingAccountId.Value,
                    TransactionDate = contribDate,
                    Description = $"Sinking Fund: {fund.Name} – transfer to savings",
                    Amount = -fund.EffectiveMonthlyContribution,
                    Category = TransactionCategory.SinkingFundContribution,
                    ReferenceId = fund.Id,
                    IsProjected = true
                });
                // Inflow to savings (destination) account
                transactions.Add(new CashFlowTransaction
                {
                    UserId = _userId,
                    BankAccountId = fund.BankAccountId.Value,
                    TransactionDate = contribDate,
                    Description = $"Sinking Fund: {fund.Name} – contribution received",
                    Amount = fund.EffectiveMonthlyContribution,
                    Category = TransactionCategory.SinkingFundContribution,
                    ReferenceId = fund.Id,
                    IsProjected = true
                });
            }
            else
            {
                // Single-account bucket: show as a reservation reminder (negative = reserved/locked)
                transactions.Add(new CashFlowTransaction
                {
                    UserId = _userId,
                    BankAccountId = fund.BankAccountId.Value,
                    TransactionDate = contribDate,
                    Description = $"Sinking Fund: {fund.Name} – reserve",
                    Amount = -fund.EffectiveMonthlyContribution,
                    Category = TransactionCategory.SinkingFundContribution,
                    ReferenceId = fund.Id,
                    IsProjected = true
                });
            }
            contribDate = contribDate.AddMonths(1);
        }

        // Lump-sum payment dates within horizon
        var payDate = fund.NextDueDate;
        while (payDate <= cutoff)
        {
            transactions.Add(new CashFlowTransaction
            {
                UserId = _userId,
                BankAccountId = fund.BankAccountId.Value,
                TransactionDate = payDate,
                Description = $"Sinking Fund Payment: {fund.Name}",
                Amount = -fund.TargetAmount,
                Category = TransactionCategory.SinkingFundPayment,
                ReferenceId = fund.Id,
                IsProjected = true
            });
            payDate = payDate.AddMonths(fund.PeriodMonths);
        }

        if (transactions.Count > 0)
            await CashFlowRepo.BulkInsertProjectedAsync(transactions);

        await LoadAsync();
    }

    private static string FormatFrequency(SinkingFundFrequency f) => f switch
    {
        SinkingFundFrequency.Annual     => "Annual",
        SinkingFundFrequency.SemiAnnual => "Semi-Annual",
        SinkingFundFrequency.Quarterly  => "Quarterly",
        SinkingFundFrequency.Monthly    => "Monthly",
        _                               => f.ToString()
    };
}
