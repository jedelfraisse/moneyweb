@page "/admin/stats"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using MoneyWeb.Blazor.Services
@using MoneyWeb.Data.Models
@using MoneyWeb.Data.Repositories.Interfaces
@inject CurrentUserService CurrentUserSvc
@inject IUserRepository UserRepo

<PageTitle>Admin Stats</PageTitle>

@if (_currentUser is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (!_currentUser.IsAdmin)
{
    <div class="alert alert-danger">Access denied. Admins only.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Admin Stats</h1>
        <a href="admin/users" class="btn btn-sm btn-outline-secondary">👥 Manage Users</a>
    </div>

    @* ── Summary cards ── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-6 fw-bold">@_users.Count</div>
                    <div class="text-muted small">Total Users</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100 border-success">
                <div class="card-body">
                    <div class="display-6 fw-bold text-success">@_users.Count(u => u.IsApproved)</div>
                    <div class="text-muted small">Approved</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100 border-warning">
                <div class="card-body">
                    <div class="display-6 fw-bold text-warning">@_users.Count(u => !u.IsApproved && !u.IsDeclined)</div>
                    <div class="text-muted small">Pending</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100 border-primary">
                <div class="card-body">
                    <div class="display-6 fw-bold text-primary">@_users.Count(u => u.IsAdmin)</div>
                    <div class="text-muted small">Admins</div>
                </div>
            </div>
        </div>
    </div>

    @* ── Postal code breakdown ── *@
    <h5 class="mb-3">Users by Postal Code</h5>
    @if (_postalStats.Count == 0)
    {
        <p class="text-muted">No postal code data yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle" style="max-width:500px">
                <thead class="table-dark">
                    <tr>
                        <th>Postal Code</th>
                        <th class="text-end">Users</th>
                        <th class="text-end">% of Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (zip, count) in _postalStats)
                    {
                        var pct = _users.Count > 0 ? (count * 100.0 / _users.Count) : 0;
                        <tr>
                            <td>
                                @if (string.IsNullOrWhiteSpace(zip))
                                {
                                    <span class="text-muted fst-italic">Not set</span>
                                }
                                else
                                {
                                    <span class="fw-semibold">@zip</span>
                                }
                            </td>
                            <td class="text-end">
                                <span class="badge bg-secondary">@count</span>
                            </td>
                            <td class="text-end text-muted small">@pct.ToString("0.#")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ── Signups over time (by month) ── *@
    @if (_monthlySignups.Count > 0)
    {
        <h5 class="mt-4 mb-3">Signups by Month</h5>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle" style="max-width:400px">
                <thead class="table-dark">
                    <tr>
                        <th>Month</th>
                        <th class="text-end">New Users</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (month, count) in _monthlySignups)
                    {
                        <tr>
                            <td>@month</td>
                            <td class="text-end"><span class="badge bg-secondary">@count</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private User? _currentUser;
    private List<User> _users = [];
    private List<(string Zip, int Count)> _postalStats = [];
    private List<(string Month, int Count)> _monthlySignups = [];

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await CurrentUserSvc.GetCurrentUserAsync();
        if (_currentUser?.IsAdmin != true) return;

        _users = (await UserRepo.GetAllAsync()).ToList();

        _postalStats = _users
            .GroupBy(u => u.PostalCode?.Trim() ?? string.Empty)
            .Select(g => (Zip: g.Key, Count: g.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Zip)
            .ToList();

        _monthlySignups = _users
            .GroupBy(u => new { u.CreatedAt.Year, u.CreatedAt.Month })
            .Select(g => (Month: new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMM yyyy"), Count: g.Count()))
            .OrderByDescending(x => x.Month)
            .ToList();
    }
}
