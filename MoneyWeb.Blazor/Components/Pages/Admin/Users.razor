@page "/admin/users"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using MoneyWeb.Blazor.Services
@using MoneyWeb.Data.Models
@using MoneyWeb.Data.Repositories.Interfaces
@inject CurrentUserService CurrentUserSvc
@inject IUserRepository UserRepo
@inject NavigationManager Navigation

<PageTitle>User Management</PageTitle>

@if (_currentUser is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (!_currentUser.IsAdmin)
{
    <div class="alert alert-danger">Access denied. Admins only.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">User Management</h1>
        <div class="d-flex align-items-center gap-2">
            <div class="btn-group btn-group-sm" role="group">
                <button class="btn @(_filter == "all"      ? "btn-dark"              : "btn-outline-secondary")" @onclick='() => _filter = "all"'>All <span class="badge bg-secondary ms-1">@_users.Count</span></button>
                <button class="btn @(_filter == "approved" ? "btn-success"           : "btn-outline-success")"   @onclick='() => _filter = "approved"'>Approved <span class="badge bg-secondary ms-1">@_users.Count(u => u.IsApproved)</span></button>
                <button class="btn @(_filter == "pending"  ? "btn-warning text-dark" : "btn-outline-warning")"   @onclick='() => _filter = "pending"'>Pending <span class="badge bg-secondary ms-1">@_users.Count(u => !u.IsApproved && !u.IsDeclined)</span></button>
                <button class="btn @(_filter == "declined" ? "btn-danger"            : "btn-outline-danger")"    @onclick='() => _filter = "declined"'>Declined <span class="badge bg-secondary ms-1">@_users.Count(u => u.IsDeclined)</span></button>
                <button class="btn @(_filter == "admin"    ? "btn-primary"           : "btn-outline-primary")"   @onclick='() => _filter = "admin"'>Admin <span class="badge bg-secondary ms-1">@_users.Count(u => u.IsAdmin)</span></button>
            </div>
            <a href="admin/stats" class="btn btn-sm btn-outline-secondary">📊 Stats</a>
            <a href="admin/maintenance" class="btn btn-sm btn-outline-secondary">🧹 Maintenance</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success alert-dismissible">
            @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    <div class="alert alert-info small">
        Sign-in diagnostics show the raw claims captured from each user's most recent login. Have the user sign out and back in, then refresh this page to inspect the latest payload.
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Postal Code</th>
                    <th>Joined</th>
                    <th>Last Login</th>
                    <th>Status</th>
                    <th class="text-center">Admin</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _filteredUsers)
                {
                    <tr class="@(user.Id == _currentUser.Id ? "table-active" : user.IsDeclined ? "table-danger" : !user.IsApproved ? "table-warning" : "")">
                        <td>
                            @user.DisplayName
                            @if (user.Id == _currentUser.Id)
                            {
                                <span class="badge bg-primary ms-1">You</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(user.RequestReason))
                            {
                                <div class="text-muted small fst-italic mt-1">
                                    💬 "@user.RequestReason"
                                </div>
                            }
                        </td>
                        <td class="text-muted small">@user.Email</td>
                        <td class="small">@(string.IsNullOrWhiteSpace(user.PostalCode) ? "—" : user.PostalCode)</td>
                        <td class="small">@user.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td class="small">@(user.LastLoginAtUtc?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ?? "—")</td>
                        <td>
                            @if (user.IsApproved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (user.IsDeclined)
                            {
                                <span class="badge bg-danger">Declined</span>
                                @if (!string.IsNullOrWhiteSpace(user.DeclineReason))
                                {
                                    <div class="text-muted small fst-italic mt-1">@user.DeclineReason</div>
                                }
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="form-check form-switch d-flex justify-content-center">
                                <input class="form-check-input" type="checkbox"
                                       checked="@user.IsAdmin"
                                       disabled="@(user.Id == _currentUser.Id)"
                                       @onchange="e => ToggleAdmin(user, (bool)e.Value!)" />
                            </div>
                        </td>
                        <td class="text-end" style="white-space:nowrap">
                            @if (user.Id != _currentUser.Id)
                            {
                                @if (!user.IsApproved)
                                {
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => ApproveUser(user)" title="Approve">
                                        ✅ Approve
                                    </button>
                                }
                                @if (!user.IsDeclined)
                                {
                                    <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => StartDecline(user)" title="Decline">
                                        ❌ Decline
                                    </button>
                                }
                                @if (user.IsApproved)
                                {
                                    <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => RevokeApproval(user)" title="Revoke approval">
                                        🔒 Revoke
                                    </button>
                                }
                                 <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(user)" title="Delete all data">
                                     <i class="bi bi-trash"></i>
                                 </button>
                             }
                             <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => ToggleDiagnostics(user.Id)" title="Show login diagnostics">
                                 @(_expandedDiagnostics.Contains(user.Id) ? "Hide Raw Data" : "Raw Data")
                             </button>
                         </td>
                     </tr>
                    @if (_expandedDiagnostics.Contains(user.Id))
                    {
                        <tr class="table-light">
                            <td colspan="8">
                                <div class="small text-muted mb-2">
                                    Raw sign-in claims captured on @(user.LastLoginAtUtc?.ToLocalTime().ToString("f") ?? "the most recent login is not recorded yet").
                                </div>
                                <pre class="bg-dark text-light rounded p-3 small mb-0" style="white-space: pre-wrap;">@GetDiagnosticsText(user)</pre>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@* ── Decline modal ── *@
@if (_userToDecline is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Decline Request</h5>
                    <button type="button" class="btn-close" @onclick="() => _userToDecline = null"></button>
                </div>
                <div class="modal-body">
                    <p>Declining access for <strong>@_userToDecline.DisplayName</strong>.</p>
                    <label class="form-label">Reason <span class="text-muted small">(shown to the user)</span></label>
                    <textarea class="form-control" rows="3" placeholder="e.g. Account not yet open to new users."
                              @bind="_declineReasonInput"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _userToDecline = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeclineUser">Decline</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Delete confirm modal ── *@
@if (_userToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Remove User</h5>
                    <button type="button" class="btn-close" @onclick="() => _userToDelete = null"></button>
                </div>
                <div class="modal-body">
                    Delete all data for <strong>@_userToDelete.DisplayName</strong> and remove their account?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _userToDelete = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteUser">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private User? _currentUser;
    private List<User> _users = [];
    private string? _message;
    private User? _userToDelete;
    private User? _userToDecline;
    private string _declineReasonInput = string.Empty;
    private string _filter = "all";
    private HashSet<int> _expandedDiagnostics = [];

    private IEnumerable<User> _filteredUsers => _filter switch
    {
        "approved" => _users.Where(u => u.IsApproved),
        "pending"  => _users.Where(u => !u.IsApproved && !u.IsDeclined),
        "declined" => _users.Where(u => u.IsDeclined),
        "admin"    => _users.Where(u => u.IsAdmin),
        _          => _users
    };

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await CurrentUserSvc.GetCurrentUserAsync();
        if (_currentUser?.IsAdmin == true)
            _users = (await UserRepo.GetAllAsync()).ToList();
    }

    private async Task ApproveUser(User user)
    {
        user.IsApproved = true;
        user.IsDeclined = false;
        user.DeclineReason = string.Empty;
        await UserRepo.UpdateAsync(user);
        _message = $"{user.DisplayName} has been approved.";
    }

    private void StartDecline(User user)
    {
        _userToDecline = user;
        _declineReasonInput = string.Empty;
    }

    private async Task DeclineUser()
    {
        if (_userToDecline is null) return;
        _userToDecline.IsApproved = false;
        _userToDecline.IsDeclined = true;
        _userToDecline.DeclineReason = _declineReasonInput.Trim();
        await UserRepo.UpdateAsync(_userToDecline);
        _message = $"{_userToDecline.DisplayName} has been declined.";
        _userToDecline = null;
    }

    private async Task RevokeApproval(User user)
    {
        user.IsApproved = false;
        user.IsDeclined = false;
        await UserRepo.UpdateAsync(user);
        _message = $"{user.DisplayName}'s approval has been revoked.";
    }

    private async Task ToggleAdmin(User user, bool value)
    {
        user.IsAdmin = value;
        await UserRepo.UpdateAsync(user);
        _message = $"{user.DisplayName} admin status set to {value}.";
    }

    private void ToggleDiagnostics(int userId)
    {
        if (!_expandedDiagnostics.Add(userId))
        {
            _expandedDiagnostics.Remove(userId);
        }
    }

    private static string GetDiagnosticsText(User user)
        => string.IsNullOrWhiteSpace(user.LastLoginClaimsJson)
            ? "No raw claims have been captured for this user yet."
            : user.LastLoginClaimsJson;

    private void ConfirmDelete(User user) => _userToDelete = user;

    private async Task DeleteUser()
    {
        if (_userToDelete is null) return;
        await UserRepo.DeleteUserDataAsync(_userToDelete.Id);
        _users = (await UserRepo.GetAllAsync()).ToList();
        _message = $"Data for {_userToDelete.DisplayName} has been deleted.";
        _userToDelete = null;
    }
}

