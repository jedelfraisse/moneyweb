@page "/debts"
@rendermode InteractiveServer
@using MoneyWeb.Blazor.Services
@using MoneyWeb.Data.Models
@using MoneyWeb.Data.Repositories.Interfaces
@using MoneyWeb.Data.Services
@attribute [Authorize]
@inject CurrentUserService CurrentUserService
@inject IDebtRepository DebtRepo
@inject IDebtGroupRepository GroupRepo
@inject IBankAccountRepository AccountRepo
@inject DebtPayoffService PayoffSvc

<PageTitle>Debts – MoneyWeb</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Debts</h1>
    <div>
        <button class="btn btn-outline-secondary me-2" @onclick="OpenAddGroup">New Group</button>
        <button class="btn btn-primary" @onclick="() => OpenAddDebt(null)">Add Debt</button>
    </div>
</div>

@if (_loading)
{
    <p>Loading&hellip;</p>
}
else
{
    @* ── Grouped debts ── *@
    @foreach (var group in _groups)
    {
        var result = _payoffResults[group.Id];
        var active = _activeStrategies[group.Id];
        var activeResult = result.ForStrategy(active);
        var minSum = group.Debts.Sum(d => d.MinimumPayment);
        var overBudget = minSum > group.MonthlyBudget;

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>@group.Name</strong>
                    @if (group.BankAccount is not null)
                    {
                        <span class="badge bg-secondary ms-2">@group.BankAccount.Name</span>
                    }
                    <span class="ms-2 text-muted small">Budget: @group.MonthlyBudget.ToString("C")/mo</span>
                    @if (overBudget)
                    {
                        <span class="badge bg-danger ms-2" title="Minimum payments exceed budget">
                            Budget short @((minSum - group.MonthlyBudget).ToString("C"))
                        </span>
                    }
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <select class="form-select form-select-sm" style="width:auto"
                            value="@active"
                            @onchange="e => ChangeStrategy(group.Id, Enum.Parse<PayoffStrategy>(e.Value!.ToString()!))">
                        <option value="@PayoffStrategy.Avalanche">Avalanche</option>
                        <option value="@PayoffStrategy.Snowball">Snowball</option>
                        <option value="@PayoffStrategy.Custom">Custom</option>
                        <option value="@PayoffStrategy.MinimumOnly">Min Only</option>
                    </select>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditGroup(group)">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteGroup(group)">Delete</button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenAddDebt(group.Id)">+ Debt</button>
                </div>
            </div>

            @* Strategy comparison *@
            <div class="card-body border-bottom pb-2">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th></th>
                            <th class="text-end @(active == PayoffStrategy.Avalanche    ? "text-primary fw-bold" : "")">Avalanche</th>
                            <th class="text-end @(active == PayoffStrategy.Snowball     ? "text-primary fw-bold" : "")">Snowball</th>
                            <th class="text-end @(active == PayoffStrategy.Custom       ? "text-primary fw-bold" : "")">Custom</th>
                            <th class="text-end @(active == PayoffStrategy.MinimumOnly  ? "text-primary fw-bold" : "")">Min Only</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-muted small">Total interest</td>
                            <td class="text-end @(active == PayoffStrategy.Avalanche   ? "fw-bold" : "")">@result.Avalanche.TotalInterestPaid.ToString("C")</td>
                            <td class="text-end @(active == PayoffStrategy.Snowball    ? "fw-bold" : "")">@result.Snowball.TotalInterestPaid.ToString("C")</td>
                            <td class="text-end @(active == PayoffStrategy.Custom      ? "fw-bold" : "")">@result.Custom.TotalInterestPaid.ToString("C")</td>
                            <td class="text-end @(active == PayoffStrategy.MinimumOnly ? "fw-bold" : "")">@result.MinimumOnly.TotalInterestPaid.ToString("C")</td>
                        </tr>
                        <tr>
                            <td class="text-muted small">Debt-free date</td>
                            <td class="text-end @(active == PayoffStrategy.Avalanche   ? "fw-bold" : "")">@result.Avalanche.PayoffDate.ToString("MMM yyyy")</td>
                            <td class="text-end @(active == PayoffStrategy.Snowball    ? "fw-bold" : "")">@result.Snowball.PayoffDate.ToString("MMM yyyy")</td>
                            <td class="text-end @(active == PayoffStrategy.Custom      ? "fw-bold" : "")">@result.Custom.PayoffDate.ToString("MMM yyyy")</td>
                            <td class="text-end @(active == PayoffStrategy.MinimumOnly ? "fw-bold" : "")">@result.MinimumOnly.PayoffDate.ToString("MMM yyyy")</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @* Debt rows *@
            @if (group.Debts.Any())
            {
                var orderedDebts = group.Debts.OrderBy(d => d.GroupSortOrder).ThenBy(d => d.Id).ToList();
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width:5rem"></th>
                                <th>Debt</th>
                                <th>Lender</th>
                                <th class="text-end">Balance</th>
                                <th class="text-end">Rate</th>
                                <th class="text-end">Min Payment</th>
                                <th class="text-end">Payoff (@active)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < orderedDebts.Count; i++)
                            {
                                var debt = orderedDebts[i];
                                var idx = i;
                                var payoffDate = activeResult.DebtPayoffDates.TryGetValue(debt.Id, out var d) ? d : (DateOnly?)null;
                                <tr>
                                    <td class="text-nowrap">
                                        <button class="btn btn-sm btn-outline-secondary px-1 py-0"
                                                disabled="@(idx == 0)"
                                                @onclick="() => MoveDebt(orderedDebts, idx, -1)">▲</button>
                                        <button class="btn btn-sm btn-outline-secondary px-1 py-0"
                                                disabled="@(idx == orderedDebts.Count - 1)"
                                                @onclick="() => MoveDebt(orderedDebts, idx, 1)">▼</button>
                                    </td>
                                    <td>@debt.Name</td>
                                    <td class="text-muted small">@debt.Lender</td>
                                    <td class="text-end">@debt.Balance.ToString("C")</td>
                                    <td class="text-end">@((debt.InterestRate * 100).ToString("F2"))%</td>
                                    <td class="text-end">@debt.MinimumPayment.ToString("C")</td>
                                    <td class="text-end">@(payoffDate?.ToString("MMM yyyy") ?? "—")</td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditDebt(debt)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteDebt(debt)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td></td>
                                <td colspan="2">Group Total</td>
                                <td class="text-end">@group.Debts.Sum(d => d.Balance).ToString("C")</td>
                                <td></td>
                                <td class="text-end">@group.Debts.Sum(d => d.MinimumPayment).ToString("C")</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-muted small">No debts in this group yet.</div>
            }
        </div>
    }

    @* ── Ungrouped debts ── *@
    @if (_ungrouped.Any())
    {
        <h2 class="h5">Ungrouped Debts</h2>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Debt</th>
                    <th>Lender</th>
                    <th class="text-end">Balance</th>
                    <th class="text-end">Rate</th>
                    <th class="text-end">Min Payment</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var debt in _ungrouped)
                {
                    <tr>
                        <td>@debt.Name</td>
                        <td class="text-muted small">@debt.Lender</td>
                        <td class="text-end">@debt.Balance.ToString("C")</td>
                        <td class="text-end">@((debt.InterestRate * 100).ToString("F2"))%</td>
                        <td class="text-end">@debt.MinimumPayment.ToString("C")</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditDebt(debt)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteDebt(debt)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="2">Ungrouped Total</td>
                    <td class="text-end">@_ungrouped.Sum(d => d.Balance).ToString("C")</td>
                    <td></td>
                    <td class="text-end">@_ungrouped.Sum(d => d.MinimumPayment).ToString("C")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    }

    @if (!_groups.Any() && !_ungrouped.Any())
    {
        <p class="text-muted">No debts yet. Add a group or a standalone debt to get started.</p>
    }
}

@* ── Group Modal ── *@
@if (_showGroupModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingGroup.Id == 0 ? "New" : "Edit") Debt Group</h5>
                    <button type="button" class="btn-close" @onclick="CloseGroupModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Group Name</label>
                        <input class="form-control" @bind="_editingGroup.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bank Account (optional)</label>
                        <select class="form-select" @bind="_editingGroup.BankAccountId">
                            <option value="">— None —</option>
                            @foreach (var acct in _bankAccounts)
                            {
                                <option value="@acct.Id">@acct.Name (@acct.AccountType)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Monthly Budget</label>
                        <input class="form-control" type="number" step="0.01" @bind="_editingGroup.MonthlyBudget" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Default Strategy</label>
                        <select class="form-select" @bind="_editingGroup.Strategy">
                            <option value="@PayoffStrategy.Avalanche">Avalanche (highest interest first)</option>
                            <option value="@PayoffStrategy.Snowball">Snowball (smallest balance first)</option>
                            <option value="@PayoffStrategy.Custom">Custom order</option>
                            <option value="@PayoffStrategy.MinimumOnly">Minimum payments only</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" rows="2" @bind="_editingGroup.Notes"></textarea>
                    </div>
                    @if (_groupError is not null)
                    {
                        <div class="alert alert-danger">@_groupError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseGroupModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveGroup">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Debt Modal ── *@
@if (_showDebtModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingDebt.Id == 0 ? "Add" : "Edit") Debt</h5>
                    <button type="button" class="btn-close" @onclick="CloseDebtModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="_editingDebt.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lender</label>
                        <input class="form-control" @bind="_editingDebt.Lender" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Balance</label>
                        <input class="form-control" type="number" step="0.01" @bind="_editingDebt.Balance" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Interest Rate (%)</label>
                        <input class="form-control" type="number" step="0.01"
                               value="@(_editingDebt.InterestRate * 100)"
                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var r)) _editingDebt.InterestRate = r / 100m; }" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Minimum Payment</label>
                        <input class="form-control" type="number" step="0.01" @bind="_editingDebt.MinimumPayment" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Group (optional)</label>
                        <select class="form-select" value="@_groupIdStr"
                                @onchange="e => _groupIdStr = e.Value?.ToString() ?? string.Empty">
                            <option value="">— Ungrouped —</option>
                            @foreach (var g in _groups)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </select>
                    </div>
                    @if (!string.IsNullOrEmpty(_groupIdStr))
                    {
                        <div class="mb-3">
                            <label class="form-label">Sort Order (for Custom strategy)</label>
                            <input class="form-control" type="number" @bind="_editingDebt.GroupSortOrder" />
                        </div>
                    }
                    @if (_debtError is not null)
                    {
                        <div class="alert alert-danger">@_debtError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDebtModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveDebt">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Delete Confirm Modals ── *@
@if (_deleteGroupTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Delete Group</h5></div>
                <div class="modal-body">
                    <p>Delete group <strong>@_deleteGroupTarget.Name</strong>?</p>
                    <p class="text-muted small">Debts in this group will become ungrouped — they will not be deleted.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _deleteGroupTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteGroupConfirmed">Delete Group</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_deleteDebtTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Delete Debt</h5></div>
                <div class="modal-body">
                    <p>Delete <strong>@_deleteDebtTarget.Name</strong>? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _deleteDebtTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteDebtConfirmed">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private int _userId;

    private List<DebtGroup> _groups = [];
    private List<Debt> _ungrouped = [];
    private List<BankAccount> _bankAccounts = [];
    private Dictionary<int, DebtPayoffResult> _payoffResults = [];
    private Dictionary<int, PayoffStrategy> _activeStrategies = [];

    // Group modal
    private bool _showGroupModal;
    private DebtGroup _editingGroup = new();
    private string? _groupError;
    private DebtGroup? _deleteGroupTarget;

    // Debt modal
    private bool _showDebtModal;
    private Debt _editingDebt = new();
    private string _groupIdStr = string.Empty;
    private string? _debtError;
    private Debt? _deleteDebtTarget;

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user?.IsApproved != true) return;
        _userId = user.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _bankAccounts = (await AccountRepo.GetAllAsync(_userId)).ToList();

        _groups = (await GroupRepo.GetAllWithDebtsAsync(_userId)).ToList();

        _payoffResults = _groups.ToDictionary(
            g => g.Id,
            g => PayoffSvc.Calculate(g.Debts, g.MonthlyBudget));

        // Preserve active strategy selection across reloads
        foreach (var g in _groups)
            _activeStrategies.TryAdd(g.Id, g.Strategy);

        var allDebts = (await DebtRepo.GetAllAsync(_userId, activeOnly: true)).ToList();
        _ungrouped = allDebts.Where(d => d.GroupId is null).ToList();

        _loading = false;
    }

    private void ChangeStrategy(int groupId, PayoffStrategy strategy) =>
        _activeStrategies[groupId] = strategy;

    // ── Group CRUD ──────────────────────────────────────────────
    private void OpenAddGroup()
    {
        _editingGroup = new DebtGroup { UserId = _userId };
        _groupError = null;
        _showGroupModal = true;
    }

    private void OpenEditGroup(DebtGroup g)
    {
        _editingGroup = new DebtGroup
        {
            Id = g.Id, UserId = g.UserId, Name = g.Name,
            BankAccountId = g.BankAccountId, Strategy = g.Strategy,
            MonthlyBudget = g.MonthlyBudget, Notes = g.Notes
        };
        _groupError = null;
        _showGroupModal = true;
    }

    private void CloseGroupModal() => _showGroupModal = false;

    private async Task SaveGroup()
    {
        if (string.IsNullOrWhiteSpace(_editingGroup.Name)) { _groupError = "Name is required."; return; }
        _editingGroup.UserId = _userId;
        if (_editingGroup.Id == 0)
            await GroupRepo.CreateAsync(_editingGroup);
        else
            await GroupRepo.UpdateAsync(_editingGroup);
        _showGroupModal = false;
        await LoadAsync();
    }

    private void ConfirmDeleteGroup(DebtGroup g) => _deleteGroupTarget = g;

    private async Task MoveDebt(List<Debt> ordered, int index, int direction)
    {
        var swapIndex = index + direction;
        if (swapIndex < 0 || swapIndex >= ordered.Count) return;

        // Normalise sort orders to sequential positions, then swap the two affected
        for (int i = 0; i < ordered.Count; i++)
            ordered[i].GroupSortOrder = i;

        (ordered[index].GroupSortOrder, ordered[swapIndex].GroupSortOrder) =
            (ordered[swapIndex].GroupSortOrder, ordered[index].GroupSortOrder);

        await DebtRepo.UpdateAsync(ordered[index]);
        await DebtRepo.UpdateAsync(ordered[swapIndex]);
        await LoadAsync();
    }

    private async Task DeleteGroupConfirmed()
    {
        if (_deleteGroupTarget is null) return;
        await GroupRepo.DeleteAsync(_deleteGroupTarget.Id, _userId);
        _deleteGroupTarget = null;
        await LoadAsync();
    }

    // ── Debt CRUD ────────────────────────────────────────────────
    private void OpenAddDebt(int? groupId)
    {
        _editingDebt = new Debt { UserId = _userId, IsActive = true };
        _groupIdStr = groupId.HasValue ? groupId.Value.ToString() : string.Empty;
        _debtError = null;
        _showDebtModal = true;
    }

    private void OpenEditDebt(Debt d)
    {
        _editingDebt = new Debt
        {
            Id = d.Id, UserId = d.UserId, GroupId = d.GroupId, GroupSortOrder = d.GroupSortOrder,
            Name = d.Name, Lender = d.Lender, Balance = d.Balance,
            InterestRate = d.InterestRate, MinimumPayment = d.MinimumPayment,
            PayoffDate = d.PayoffDate, IsActive = d.IsActive
        };
        _groupIdStr = d.GroupId.HasValue ? d.GroupId.Value.ToString() : string.Empty;
        _debtError = null;
        _showDebtModal = true;
    }

    private void CloseDebtModal() => _showDebtModal = false;

    private async Task SaveDebt()
    {
        if (string.IsNullOrWhiteSpace(_editingDebt.Name)) { _debtError = "Name is required."; return; }
        if (_editingDebt.Balance < 0) { _debtError = "Balance cannot be negative."; return; }
        _editingDebt.GroupId = int.TryParse(_groupIdStr, out var gid) ? gid : null;
        _editingDebt.UserId = _userId;
        if (_editingDebt.Id == 0)
            await DebtRepo.CreateAsync(_editingDebt);
        else
            await DebtRepo.UpdateAsync(_editingDebt);
        _showDebtModal = false;
        await LoadAsync();
    }

    private void ConfirmDeleteDebt(Debt d) => _deleteDebtTarget = d;

    private async Task DeleteDebtConfirmed()
    {
        if (_deleteDebtTarget is null) return;
        await DebtRepo.DeleteAsync(_deleteDebtTarget.Id, _userId);
        _deleteDebtTarget = null;
        await LoadAsync();
    }
}
