@page "/debts"
@rendermode InteractiveServer
@using MoneyWeb.Blazor.Services
@using MoneyWeb.Data.Models
@using MoneyWeb.Data.Repositories.Interfaces
@using MoneyWeb.Data.Services
@attribute [Authorize]
@inject CurrentUserService CurrentUserService
@inject IDebtRepository DebtRepo
@inject IDebtGroupRepository GroupRepo
@inject IBankAccountRepository AccountRepo
@inject DebtPayoffService PayoffSvc
@inject NavigationManager Nav
@inject IUserGroupRepository UserGroupRepo
@inject ICashFlowRepository CashFlowRepo
@inject IShareRepository ShareRepo
@inject SqidsEncoder<int> Sqids

<PageTitle>Debts – MoneyWeb</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Debts <PageInfoPopover Title="Debts" Content="Manage your debts — credit cards, loans, and lines of credit. MoneyWeb uses the avalanche strategy: targeting the highest-interest debt first. When one is paid off, its freed payment cascades to the next, minimizing total interest paid over time." /></h1>
    <div>
        <button class="btn btn-outline-secondary me-2" @onclick="OpenAddGroup">New Group</button>
        <button class="btn btn-primary" @onclick="() => OpenAddDebt(null)">Add Debt</button>
    </div>
</div>

@if (_loading)
{
    <p>Loading&hellip;</p>
}
else
{
    @* ── Grouped debts ── *@
    @foreach (var group in _groups)
    {
        var result = _payoffResults[group.Id];
        var active = group.Strategy;
        var activeResult = result.ForStrategy(active);
        var minSum = group.Debts.Sum(d => d.MinimumPayment);
        var overBudget = minSum > group.MonthlyBudget;

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>@group.Name</strong>
                    @if (group.BankAccount is not null)
                    {
                        <span class="badge bg-secondary ms-2">@group.BankAccount.Name</span>
                    }
                    <span class="ms-2 text-muted small">Budget: @group.MonthlyBudget.ToString("C")/mo</span>
                    @if (_pushedGroupIds.Contains(group.Id))
                    {
                        <span class="badge bg-success ms-2" title="Projected payments are in Cash Flow">✓ Pushed</span>
                    }
                    else if (group.BankAccountId.HasValue || group.Debts.Any(d => d.BankAccountId.HasValue))
                    {
                        <span class="badge bg-light text-muted border ms-2" title="No projections in Cash Flow yet">Not pushed</span>
                    }
                    @if (overBudget)
                    {
                        var shortfall = minSum - group.MonthlyBudget;
                        var coveredBudget = Math.Ceiling(minSum);
                        <span class="badge bg-danger ms-2" title="Minimum payments exceed budget">
                            Budget short @shortfall.ToString("C")
                        </span>
                        <button class="btn btn-sm btn-outline-warning ms-1"
                                title="Set budget to @coveredBudget.ToString("C") to cover all minimum payments"
                                @onclick="() => CoverShortfall(group, coveredBudget)">
                            Cover → @coveredBudget.ToString("C")
                        </button>
                    }
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span class="badge bg-secondary">@active</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditGroup(group)">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteGroup(group)">Delete</button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenAddDebt(group.Id)">+ Debt</button>
                    @{
                        var groupHasCashFlow = group.BankAccountId.HasValue
                            || group.Debts.Any(d => d.BankAccountId.HasValue);
                    }
                    @if (groupHasCashFlow)
                    {
                        <button class="btn btn-sm btn-outline-success" @onclick="() => PushProjections(group)" title="Regenerate projected payments in Cash Flow">Push to Cash Flow</button>
                        @if (group.BankAccountId.HasValue)
                        {
                            <a class="btn btn-sm btn-link p-0 text-muted" href="/transactions/@Sqids.Encode(group.BankAccountId!.Value)">View →</a>
                        }
                    }
                </div>
            </div>

            @* Strategy comparison *@
            <div class="card-body border-bottom pb-2">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th></th>
                            <th class="text-end @(active == PayoffStrategy.Avalanche    ? "text-primary fw-bold" : "")">Avalanche</th>
                            <th class="text-end @(active == PayoffStrategy.Snowball     ? "text-primary fw-bold" : "")">Snowball</th>
                            <th class="text-end @(active == PayoffStrategy.Custom       ? "text-primary fw-bold" : "")">Custom</th>
                            <th class="text-end @(active == PayoffStrategy.MinimumOnly  ? "text-primary fw-bold" : "")">Min Only</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-muted small">Total interest</td>
                            <td class="text-end @(active == PayoffStrategy.Avalanche   ? "fw-bold" : "")">@result.Avalanche.TotalInterestPaid.ToString("C")</td>
                            <td class="text-end @(active == PayoffStrategy.Snowball    ? "fw-bold" : "")">@result.Snowball.TotalInterestPaid.ToString("C")</td>
                            <td class="text-end @(active == PayoffStrategy.Custom      ? "fw-bold" : "")">@result.Custom.TotalInterestPaid.ToString("C")</td>
                            <td class="text-end @(active == PayoffStrategy.MinimumOnly ? "fw-bold" : "")">@(result.MinimumOnly.NeverPaysOff ? "∞" : result.MinimumOnly.TotalInterestPaid.ToString("C"))</td>
                        </tr>
                        <tr>
                            <td class="text-muted small">Debt-free date</td>
                            <td class="text-end @(active == PayoffStrategy.Avalanche   ? "fw-bold" : "")">@result.Avalanche.PayoffDate.ToString("MMM yyyy")</td>
                            <td class="text-end @(active == PayoffStrategy.Snowball    ? "fw-bold" : "")">@result.Snowball.PayoffDate.ToString("MMM yyyy")</td>
                            <td class="text-end @(active == PayoffStrategy.Custom      ? "fw-bold" : "")">@result.Custom.PayoffDate.ToString("MMM yyyy")</td>
                            <td class="text-end @(active == PayoffStrategy.MinimumOnly ? "fw-bold" : "") text-danger">@(result.MinimumOnly.NeverPaysOff ? "Never" : result.MinimumOnly.PayoffDate.ToString("MMM yyyy"))</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @* Debt rows *@
            @if (group.Debts.Any())
            {
                var orderedDebts = group.Debts.OrderBy(d => d.GroupSortOrder).ThenBy(d => d.Id).ToList();
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width:5rem"></th>
                                <th>Debt</th>
                                <th class="text-end">Balance</th>
                                <th class="text-end">Rate</th>
                                <th class="text-end">Min Pmt</th>
                                <th class="text-end">Fees</th>
                                <th class="text-end">Total Pmt</th>
                                <th class="text-end">Next Pmt</th>
                                <th class="text-end">Interest</th>
                                <th class="text-center">Method</th>
                                <th class="text-end">Next Due</th>
                                <th class="text-end">Payoff (@active)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < orderedDebts.Count; i++)
                            {
                                var debt = orderedDebts[i];
                                var idx = i;
                                var payoffDate = activeResult.DebtPayoffDates.TryGetValue(debt.Id, out var d) ? d : (DateOnly?)null;
                                <tr>
                                    <td class="text-nowrap">
                                        <button class="btn btn-sm btn-outline-secondary px-1 py-0"
                                                disabled="@(idx == 0)"
                                                @onclick="() => MoveDebt(orderedDebts, idx, -1)">▲</button>
                                        <button class="btn btn-sm btn-outline-secondary px-1 py-0"
                                                disabled="@(idx == orderedDebts.Count - 1)"
                                                @onclick="() => MoveDebt(orderedDebts, idx, 1)">▼</button>
                                    </td>
                                    <td>@debt.Name</td>
                                    <td class="text-end">@debt.Balance.ToString("C")</td>
                                    <td class="text-end">@((debt.InterestRate * 100).ToString("F2"))%</td>
                                    <td class="text-end @(debt.IsMinBelowInterest ? "table-danger" : "")">
                                        @debt.MinimumPayment.ToString("C")
                                        @if (debt.IsMinBelowInterest)
                                        {
                                            var tip = $"Min payment ({debt.MinimumPayment:C}) does not cover monthly interest ({debt.MonthlyInterest:C}) — balance will keep growing!";
                                            <span title="@tip" class="ms-1">⚠️</span>
                                        }
                                    </td>
                                    <td class="text-end text-muted small">@(debt.TotalMonthlyFees > 0 ? debt.TotalMonthlyFees.ToString("C") : "—")</td>
                                    <td class="text-end fw-semibold">@debt.TotalMonthlyPayment.ToString("C")</td>
                                    <td class="text-end fw-semibold">
                                        @{
                                            var nextPmt = activeResult.NextPaymentAmounts.TryGetValue(debt.Id, out var np) ? np : debt.MinimumPayment;
                                            var isFocus = nextPmt > debt.MinimumPayment;
                                        }
                                        <span class="@(isFocus ? "text-success" : "")">@nextPmt.ToString("C")</span>
                                        @if (isFocus)
                                        {
                                            <span class="text-success small ms-1" title="Includes @((nextPmt - debt.MinimumPayment).ToString("C")) extra">★</span>
                                        }
                                    </td>
                                    <td class="text-end text-muted">
                                        @{
                                            var debtInterest = activeResult.DebtInterestPaid.TryGetValue(debt.Id, out var di) ? di : (decimal?)null;
                                        }
                                        @(debtInterest.HasValue ? debtInterest.Value.ToString("C") : "—")
                                    </td>
                                    <td class="text-center">
                                        @if (debt.PaymentMethod == DebtPaymentMethod.AutoDraft)
                                        {
                                            <span class="badge bg-success" title="Auto-draft">Auto</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark" title="Pay manually">Manual</span>
                                        }
                                        @if (debt.IsFixedPayment)
                                        {
                                            <span class="badge bg-secondary ms-1" title="Fixed payment — no extra allowed">Fixed</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (debt.NextPaymentDate.HasValue)
                                        {
                                            <span class="@(debt.NextPaymentDate.Value <= DateOnly.FromDateTime(DateTime.Today.AddDays(7)) ? "text-danger fw-semibold" : "")">
                                                @debt.NextPaymentDate.Value.ToString("MMM d")
                                            </span>
                                            <button class="btn btn-sm btn-outline-success ms-1 px-1 py-0" title="Confirm payment made"
                                                    @onclick="() => ConfirmPayment(debt)">✓</button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end">@(payoffDate?.ToString("MMM yyyy") ?? "—")</td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-sm btn-outline-info me-1" @onclick="() => OpenSchedule(debt, activeResult)" title="View payment schedule">Schedule</button>
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditDebt(debt)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteDebt(debt)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td></td>
                                <td>Group Total</td>
                                <td class="text-end">@group.Debts.Sum(d => d.Balance).ToString("C")</td>
                                <td></td>
                                <td class="text-end">@group.Debts.Sum(d => d.MinimumPayment).ToString("C")</td>
                                <td class="text-end text-muted small">@(group.Debts.Sum(d => d.TotalMonthlyFees) > 0 ? group.Debts.Sum(d => d.TotalMonthlyFees).ToString("C") : "—")</td>
                                <td class="text-end fw-semibold">@group.Debts.Sum(d => d.TotalMonthlyPayment).ToString("C")</td>
                                <td class="text-end text-success">
                                    @{
                                        var totalNextPmt = group.Debts.Sum(d => activeResult.NextPaymentAmounts.TryGetValue(d.Id, out var np) ? np : d.MinimumPayment);
                                    }
                                    @totalNextPmt.ToString("C")
                                </td>
                                <td class="text-end text-muted">
                                    @{
                                        var totalGroupInterest = group.Debts.Sum(d => activeResult.DebtInterestPaid.TryGetValue(d.Id, out var di) ? di : 0m);
                                    }
                                    @totalGroupInterest.ToString("C")
                                </td>
                                <td colspan="4"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="card-body text-muted small">No debts in this group yet.</div>
            }
        </div>
    }

    @* ── Ungrouped debts ── *@
    @if (_ungrouped.Any())
    {
        <h2 class="h5">Ungrouped Debts</h2>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Debt</th>
                    <th class="text-end">Balance</th>
                    <th class="text-end">Rate</th>
                    <th class="text-end">Min Payment</th>
                    <th class="text-end">Fees</th>
                    <th class="text-end">Total Pmt</th>
                    <th class="text-center">Method</th>
                    <th>Bank</th>
                    <th class="text-end">Next Due</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var debt in _ungrouped)
                {
                    <tr>
                        <td>@debt.Name</td>
                        <td class="text-end">@debt.Balance.ToString("C")</td>
                        <td class="text-end">@((debt.InterestRate * 100).ToString("F2"))%</td>
                        <td class="text-end @(debt.IsMinBelowInterest ? "table-danger" : "")">
                            @debt.MinimumPayment.ToString("C")
                            @if (debt.IsMinBelowInterest)
                            {
                            var tipU = $"Min payment ({debt.MinimumPayment:C}) does not cover monthly interest ({debt.MonthlyInterest:C}) — balance will keep growing!";
                            <span title="@tipU" class="ms-1">⚠️</span>
                            }
                        </td>
                        <td class="text-end text-muted small">@(debt.TotalMonthlyFees > 0 ? debt.TotalMonthlyFees.ToString("C") : "—")</td>
                        <td class="text-end fw-semibold">@debt.TotalMonthlyPayment.ToString("C")</td>
                        <td class="text-center">
                            @if (debt.PaymentMethod == DebtPaymentMethod.AutoDraft)
                            {
                                <span class="badge bg-success" title="Auto-draft">Auto</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark" title="Pay manually">Manual</span>
                            }
                            @if (debt.IsFixedPayment)
                            {
                                <span class="badge bg-secondary ms-1" title="Fixed payment — no extra allowed">Fixed</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (debt.BankAccount is not null)
                            {
                                <span class="text-muted small">@debt.BankAccount.Name</span>
                                @if (_pushedDebtIds.Contains(debt.Id))
                                {
                                    <span class="badge bg-success ms-1" title="Projected payments are in Cash Flow">✓</span>
                                }
                                <button class="btn btn-sm btn-outline-success ms-1 px-1 py-0"
                                        title="Push projected payments to cash flow"
                                        @onclick="() => PushUngroupedDebt(debt)">↑</button>
                                <a class="btn btn-sm btn-link p-0 text-muted" href="/transactions/@Sqids.Encode(debt.BankAccountId!.Value)">→</a>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (debt.NextPaymentDate.HasValue)
                            {
                                <span class="@(debt.NextPaymentDate.Value <= DateOnly.FromDateTime(DateTime.Today.AddDays(7)) ? "text-danger fw-semibold" : "")">
                                    @debt.NextPaymentDate.Value.ToString("MMM d")
                                </span>
                                <button class="btn btn-sm btn-outline-success ms-1 px-1 py-0" title="Confirm payment made"
                                        @onclick="() => ConfirmPayment(debt)">✓</button>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-info me-1" @onclick="() => OpenScheduleUngrouped(debt)" title="View payment schedule">Schedule</button>
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditDebt(debt)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteDebt(debt)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td>Ungrouped Total</td>
                    <td class="text-end">@_ungrouped.Sum(d => d.Balance).ToString("C")</td>
                    <td></td>
                    <td class="text-end">@_ungrouped.Sum(d => d.MinimumPayment).ToString("C")</td>
                    <td class="text-end text-muted small">@(_ungrouped.Sum(d => d.TotalMonthlyFees) > 0 ? _ungrouped.Sum(d => d.TotalMonthlyFees).ToString("C") : "—")</td>
                    <td class="text-end fw-semibold">@_ungrouped.Sum(d => d.TotalMonthlyPayment).ToString("C")</td>
                    <td colspan="4"></td>
                </tr>
            </tfoot>
        </table>
    }

    @if (!_groups.Any() && !_ungrouped.Any())
    {
        <p class="text-muted">No debts yet. Add a group or a standalone debt to get started.</p>
    }
}

@if (_sharedDebts.Any())
{
    <h2 class="h5 mt-4">Shared With You</h2>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Owner</th>
                <th>Name</th>
                <th class="text-end">Balance</th>
                <th class="text-end">Interest Rate</th>
                <th class="text-end">Min. Payment</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var debt in _sharedDebts)
            {
                <tr>
                    <td><span class="badge bg-secondary">@debt.OwnerDisplayName</span></td>
                    <td>@debt.Name</td>
                    <td class="text-end">@debt.Balance.ToString("C")</td>
                    <td class="text-end">@((debt.InterestRate * 100).ToString("F2"))%</td>
                    <td class="text-end">@debt.MinimumPayment.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

@* ── Group Modal ── *@
@if (_showGroupModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingGroup.Id == 0 ? "New" : "Edit") Debt Group</h5>
                    <button type="button" class="btn-close" @onclick="CloseGroupModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Group Name</label>
                        <input class="form-control" @bind="_editingGroup.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bank Account (optional)</label>
                        <select class="form-select" @bind="_editingGroup.BankAccountId">
                            <option value="">— None —</option>
                            @foreach (var acct in _bankAccounts)
                            {
                                <option value="@acct.Id">@acct.Name (@acct.AccountType)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Monthly Budget</label>
                        <input class="form-control" type="number" step="0.01" @bind="_editingGroup.MonthlyBudget" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Default Strategy</label>
                        <select class="form-select" @bind="_editingGroup.Strategy">
                            <option value="@PayoffStrategy.Avalanche">Avalanche (highest interest first)</option>
                            <option value="@PayoffStrategy.Snowball">Snowball (smallest balance first)</option>
                            <option value="@PayoffStrategy.Custom">Custom order</option>
                            <option value="@PayoffStrategy.MinimumOnly">Minimum payments only</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" rows="2" @bind="_editingGroup.Notes"></textarea>
                    </div>
                    @if (_groupError is not null)
                    {
                        <div class="alert alert-danger">@_groupError</div>
                    }
                    @if (_showRegenWarning)
                    {
                        <div class="alert alert-warning mb-0">
                            <strong>⚠️ @_manualOverrideCount manually overridden payment date(s) will be affected.</strong>
                            <p class="mb-2 mt-1 small">Regenerating projections will clear all custom payment dates for this group. Would you like to keep them or clear everything?</p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-warning" @onclick="SaveGroupAndClearOverrides">Clear overrides &amp; regenerate</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => { _showRegenWarning = false; _ = SaveGroup(); })">Keep overrides &amp; regenerate</button>
                                <button class="btn btn-sm btn-link text-muted" @onclick="() => _showRegenWarning = false">Cancel</button>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseGroupModal">Cancel</button>
                    @if (!_showRegenWarning)
                    {
                        <button class="btn btn-primary" @onclick="SaveGroup">Save</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ── Debt Modal ── *@
@if (_showDebtModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingDebt.Id == 0 ? "Add" : "Edit") Debt</h5>
                    <button type="button" class="btn-close" @onclick="CloseDebtModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="_editingDebt.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lender</label>
                        <input class="form-control" @bind="_editingDebt.Lender" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Balance</label>
                        <input class="form-control" type="number" step="0.01" @bind="_editingDebt.Balance" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Interest Rate (%)</label>
                        <input class="form-control" type="number" step="0.01"
                               value="@(_editingDebt.InterestRate * 100)"
                               @onchange="e => { if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var r)) _editingDebt.InterestRate = r / 100m; }" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Minimum Payment</label>
                        <input class="form-control" type="number" step="0.01" @bind="_editingDebt.MinimumPayment" />
                        @if (_editingDebt.IsMinBelowInterest)
                        {
                            <div class="alert alert-danger mt-2 mb-0 py-2 small">
                                ⚠️ Min payment (@_editingDebt.MinimumPayment.ToString("C")) does not cover monthly interest (@_editingDebt.MonthlyInterest.ToString("C")) — balance will keep growing!
                            </div>
                        }
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkFixedPayment"
                                   @bind="_editingDebt.IsFixedPayment" />
                            <label class="form-check-label" for="chkFixedPayment">
                                Fixed payment — lender does not allow extra payments
                            </label>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Payment Method</label>
                            <select class="form-select" @bind="_editingDebt.PaymentMethod">
                                <option value="@DebtPaymentMethod.Manual">Manual (log in to pay)</option>
                                <option value="@DebtPaymentMethod.AutoDraft">Auto-Draft</option>
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label">Payment Day of Month</label>
                            <input class="form-control" type="number" min="1" max="31" placeholder="e.g. 15"
                                   @bind="_editingDebt.PaymentDayOfMonth" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bank Account <span class="text-muted small">(overrides group bank for this debt)</span></label>
                        <select class="form-select" value="@_debtBankIdStr"
                                @onchange="e => _debtBankIdStr = e.Value?.ToString() ?? string.Empty">
                            <option value="">— Use group bank / none —</option>
                            @foreach (var acct in _bankAccounts)
                            {
                                <option value="@acct.Id">@acct.Name (@acct.AccountType)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Group (optional)</label>
                        <select class="form-select" value="@_groupIdStr"
                                @onchange="e => _groupIdStr = e.Value?.ToString() ?? string.Empty">
                            <option value="">— Ungrouped —</option>
                            @foreach (var g in _groups)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </select>
                    </div>
                    @* ── Fees section ── *@
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Fees
                            <span class="text-muted fw-normal small">(taxes, insurance, PMI — added to payment but don't reduce balance)</span>
                        </label>
                        @if (_editingFees.Any())
                        {
                            <table class="table table-sm mb-2">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Category</th>
                                        <th class="text-end">Amount/mo</th>
                                        <th class="text-center">Active</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fee in _editingFees)
                                    {
                                        <tr>
                                            <td><input class="form-control form-control-sm" @bind="fee.Name" /></td>
                                            <td>
                                                <select class="form-select form-select-sm" @bind="fee.Category">
                                                    <option value="@DebtFeeCategory.PropertyTax">Property Tax</option>
                                                    <option value="@DebtFeeCategory.HomeownersInsurance">Homeowners Ins.</option>
                                                    <option value="@DebtFeeCategory.PMI">PMI</option>
                                                    <option value="@DebtFeeCategory.HOA">HOA</option>
                                                    <option value="@DebtFeeCategory.FloodInsurance">Flood Ins.</option>
                                                    <option value="@DebtFeeCategory.Other">Other</option>
                                                </select>
                                            </td>
                                            <td class="text-end" style="width:8rem">
                                                <input class="form-control form-control-sm text-end" type="number" step="0.01"
                                                       @bind="fee.Amount" />
                                            </td>
                                            <td class="text-center">
                                                <input type="checkbox" class="form-check-input" @bind="fee.IsActive" />
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger px-1 py-0"
                                                        @onclick="() => RemoveFee(fee)">✕</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2" class="text-muted small">Total Fees</td>
                                        <td class="text-end fw-semibold">@_editingFees.Where(f => f.IsActive).Sum(f => f.Amount).ToString("C")</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted small mb-2">No fees added yet.</p>
                        }
                        <div class="row g-2 align-items-end">
                            <div class="col">
                                <input class="form-control form-control-sm" placeholder="Fee name (e.g. Property Tax)"
                                       @bind="_newFeeName" />
                            </div>
                            <div class="col-auto">
                                <select class="form-select form-select-sm" @bind="_newFeeCategory">
                                    <option value="@DebtFeeCategory.PropertyTax">Property Tax</option>
                                    <option value="@DebtFeeCategory.HomeownersInsurance">Homeowners Ins.</option>
                                    <option value="@DebtFeeCategory.PMI">PMI</option>
                                    <option value="@DebtFeeCategory.HOA">HOA</option>
                                    <option value="@DebtFeeCategory.FloodInsurance">Flood Ins.</option>
                                    <option value="@DebtFeeCategory.Other">Other</option>
                                </select>
                            </div>
                            <div class="col-auto" style="width:8rem">
                                <input class="form-control form-control-sm" type="number" step="0.01" placeholder="Amount"
                                       @bind="_newFeeAmount" />
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-sm btn-outline-success" @onclick="AddFeeToList">+ Add Fee</button>
                            </div>
                        </div>
                    </div>
                    @* ── Sharing section ── *@
                    @if (_editingDebt.Id > 0)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Who Can See This</label>
                            @if (!_shareableUsers.Any() && !_shareableGroups.Any())
                            {
                                <p class="text-muted small mb-0">No contacts or groups yet. Add contacts on the <a href="/sharing">Sharing</a> page.</p>
                            }
                            else
                            {
                                @foreach (var u in _shareableUsers)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="share-u-@u.UserId"
                                               checked="@_debtSharedWithUserIds.Contains(u.UserId)"
                                               @onchange="e => ToggleDebtShareUser(u.UserId, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label" for="share-u-@u.UserId">@u.DisplayName</label>
                                    </div>
                                }
                                @foreach (var g in _shareableGroups)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="share-g-@g.Id"
                                               checked="@_debtSharedWithGroupIds.Contains(g.Id)"
                                               @onchange="e => ToggleDebtShareGroup(g.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label" for="share-g-@g.Id"><span class="badge bg-secondary me-1">Group</span>@g.Name</label>
                                    </div>
                                }
                            }
                        </div>
                    }
                    @if (_debtError is not null)
                    {
                        <div class="alert alert-danger">@_debtError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDebtModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveDebt">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Payment Schedule Modal ── *@
@if (_scheduleDebt is not null && _scheduleRows is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Payment Schedule — @_scheduleDebt.Name</h5>
                    <button type="button" class="btn-close" @onclick="() => _scheduleDebt = null"></button>
                </div>
                <div class="modal-body p-0">
                    @if (_scheduleRows.Count == 0)
                    {
                        <p class="p-3 text-muted">No projected payments found.</p>
                    }
                    else
                    {
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Month</th>
                                    <th class="text-end">Payment</th>
                                    <th class="text-end">Interest</th>
                                    <th class="text-end">Principal</th>
                                    <th class="text-end">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _scheduleRows)
                                {
                                    var principal = row.Amount - row.InterestAccrued;
                                    <tr>
                                        <td>@row.Date.ToString("MMM yyyy")</td>
                                        <td class="text-end">@row.Amount.ToString("C")</td>
                                        <td class="text-end text-danger">@row.InterestAccrued.ToString("C")</td>
                                        <td class="text-end text-success">@principal.ToString("C")</td>
                                        <td class="text-end fw-semibold">@row.BalanceAfter.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr class="fw-bold">
                                    <td>Totals</td>
                                    <td class="text-end">@_scheduleRows.Sum(r => r.Amount).ToString("C")</td>
                                    <td class="text-end text-danger">@_scheduleRows.Sum(r => r.InterestAccrued).ToString("C")</td>
                                    <td class="text-end text-success">@_scheduleRows.Sum(r => r.Amount - r.InterestAccrued).ToString("C")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                        <p class="text-muted small p-2 mb-0">Showing up to 60 months under the active strategy. Interest compounds monthly.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _scheduleDebt = null">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Delete Confirm Modals ── *@
@if (_deleteGroupTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Delete Group</h5></div>
                <div class="modal-body">
                    <p>Delete group <strong>@_deleteGroupTarget.Name</strong>?</p>
                    <p class="text-muted small">Debts in this group will become ungrouped — they will not be deleted.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _deleteGroupTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteGroupConfirmed">Delete Group</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_deleteDebtTarget is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Delete Debt</h5></div>
                <div class="modal-body">
                    <p>Delete <strong>@_deleteDebtTarget.Name</strong>? This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => _deleteDebtTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteDebtConfirmed">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private int _userId;
    private int _horizonMonths = 12;

    private List<DebtGroup> _groups = [];
    private List<Debt> _ungrouped = [];
    private List<Debt> _sharedDebts = [];
    private List<BankAccount> _bankAccounts = [];
    private Dictionary<int, DebtPayoffResult> _payoffResults = [];
    private HashSet<int> _pushedGroupIds = [];
    private HashSet<int> _pushedDebtIds = [];

    // Schedule modal
    private Debt? _scheduleDebt;
    private List<ScheduledPayment>? _scheduleRows;

    private void OpenSchedule(Debt debt, StrategyResult result)
    {
        _scheduleDebt = debt;
        _scheduleRows = result.PaymentSchedule.Where(p => p.DebtId == debt.Id).ToList();
    }

    private void OpenScheduleUngrouped(Debt debt)
    {
        var result = PayoffSvc.Calculate([debt], debt.MinimumPayment);
        OpenSchedule(debt, result.Avalanche);
    }

    // Group modal
    private bool _showGroupModal;
    private DebtGroup _editingGroup = new();
    private string? _groupError;
    private DebtGroup? _deleteGroupTarget;
    private PayoffStrategy _originalStrategy;
    private decimal _originalBudget;
    private int _manualOverrideCount;
    private bool _showRegenWarning;

    // Debt modal
    private bool _showDebtModal;
    private Debt _editingDebt = new();
    private string _groupIdStr = string.Empty;
    private string _debtBankIdStr = string.Empty;
    private string? _debtError;
    private Debt? _deleteDebtTarget;
    private List<DebtFee> _editingFees = [];
    private List<int> _deletedFeeIds = [];
    private string _newFeeName = string.Empty;
    private decimal _newFeeAmount;
    private DebtFeeCategory _newFeeCategory = DebtFeeCategory.Other;

    // Sharing state for debt modal
    private List<(int UserId, string DisplayName)> _shareableUsers = [];
    private List<UserGroup> _shareableGroups = [];
    private List<SharePermission> _existingDebtShares = [];
    private HashSet<int> _debtSharedWithUserIds = [];
    private HashSet<int> _debtSharedWithGroupIds = [];

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUserService.GetCurrentUserAsync();
        if (user?.IsApproved != true) return;
        _userId = user.Id;
        _horizonMonths = Math.Clamp(user.CashFlowHorizonMonths, 1, 60);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _bankAccounts = (await AccountRepo.GetAllAsync(_userId)).ToList();

        _groups = (await GroupRepo.GetAllWithDebtsAsync(_userId)).ToList();

        _payoffResults = _groups.ToDictionary(
            g => g.Id,
            g => PayoffSvc.Calculate(g.Debts, g.MonthlyBudget));

        var allDebts = (await DebtRepo.GetAllAsync(_userId, activeOnly: true)).ToList();
        _ungrouped = allDebts.Where(d => d.GroupId is null).ToList();

        _pushedGroupIds = [.. await CashFlowRepo.GetProjectedGroupIdsAsync(_userId)];
        _pushedDebtIds  = [.. await CashFlowRepo.GetProjectedSourceIdsAsync(_userId, TransactionCategory.DebtPayment)];

        _sharedDebts = (await DebtRepo.GetSharedWithMeAsync(_userId)).ToList();

        _shareableUsers = (await ShareRepo.GetShareableUsersAsync(_userId)).ToList();
        _shareableGroups = (await UserGroupRepo.GetAllForUserAsync(_userId)).ToList();

        _loading = false;
    }

    // ── Group CRUD ──────────────────────────────────────────────
    private void OpenAddGroup()
    {
        _editingGroup = new DebtGroup { UserId = _userId };
        _groupError = null;
        _showGroupModal = true;
    }

    private void OpenEditGroup(DebtGroup g)
    {
        _editingGroup = new DebtGroup
        {
            Id = g.Id, UserId = g.UserId, Name = g.Name,
            BankAccountId = g.BankAccountId, Strategy = g.Strategy,
            MonthlyBudget = g.MonthlyBudget, Notes = g.Notes
        };
        _originalStrategy = g.Strategy;
        _originalBudget = g.MonthlyBudget;
        _manualOverrideCount = 0;
        _showRegenWarning = false;
        _groupError = null;
        _showGroupModal = true;
    }

    private void CloseGroupModal()
    {
        _showGroupModal = false;
        _showRegenWarning = false;
    }

    private async Task CoverShortfall(DebtGroup group, decimal newBudget)
    {
        var updated = new DebtGroup
        {
            Id = group.Id, UserId = _userId, Name = group.Name,
            BankAccountId = group.BankAccountId, Strategy = group.Strategy,
            MonthlyBudget = newBudget, Notes = group.Notes
        };
        await GroupRepo.UpdateAsync(updated);
        await LoadAsync();
    }

    private async Task SaveGroup()
    {
        if (string.IsNullOrWhiteSpace(_editingGroup.Name)) { _groupError = "Name is required."; return; }
        _editingGroup.UserId = _userId;

        bool isNew = _editingGroup.Id == 0;
        bool strategyOrBudgetChanged = !isNew
            && (_editingGroup.Strategy != _originalStrategy || _editingGroup.MonthlyBudget != _originalBudget);

        // Warn before overwriting manual overrides when strategy/budget changes on an existing group
        if (strategyOrBudgetChanged && !_showRegenWarning)
        {
            _manualOverrideCount = await CashFlowRepo.CountManualOverridesAsync(_editingGroup.Id, _userId);
            if (_manualOverrideCount > 0)
            {
                _showRegenWarning = true;
                return; // pause — let user confirm via warning UI
            }
        }

        if (isNew)
            await GroupRepo.CreateAsync(_editingGroup);
        else
            await GroupRepo.UpdateAsync(_editingGroup);

        _showGroupModal = false;
        _showRegenWarning = false;
        await LoadAsync();

        // Always regenerate projected cash flow when a bank account is assigned
        if (_editingGroup.BankAccountId.HasValue)
            await RegenerateProjectionsAsync(_editingGroup, includeManualOverrides: false);
    }

    private async Task SaveGroupAndClearOverrides()
    {
        _showRegenWarning = false;
        _editingGroup.UserId = _userId;

        if (_editingGroup.Id == 0)
            await GroupRepo.CreateAsync(_editingGroup);
        else
            await GroupRepo.UpdateAsync(_editingGroup);

        _showGroupModal = false;
        await LoadAsync();

        if (_editingGroup.BankAccountId.HasValue)
            await RegenerateProjectionsAsync(_editingGroup, includeManualOverrides: true);
    }

    private async Task PushProjections(DebtGroup group)
    {
        int overrides = await CashFlowRepo.CountManualOverridesAsync(group.Id, _userId);
        // Always keep manual overrides when pushing manually — only clear on explicit strategy change
        await RegenerateProjectionsAsync(group, includeManualOverrides: false);
        if (overrides > 0)
            _groupError = $"Note: {overrides} manually overridden date(s) were preserved.";
    }

    private async Task RegenerateProjectionsAsync(DebtGroup group, bool includeManualOverrides)
    {
        var grp = _groups.FirstOrDefault(g => g.Id == group.Id) ?? group;

        // Determine effective bank per debt (debt's own bank, or group's bank as fallback)
        var effectiveBanks = grp.Debts.ToDictionary(
            d => d.Id,
            d => d.BankAccountId ?? group.BankAccountId);

        if (!effectiveBanks.Values.Any(id => id.HasValue)) return; // nothing to push

        // Delete existing projected transactions for this group
        await CashFlowRepo.DeleteProjectedForGroupAsync(group.Id, _userId, includeManualOverrides);

        var result = PayoffSvc.Calculate(grp.Debts, group.MonthlyBudget);
        var cutoff = DateOnly.FromDateTime(DateTime.Today.AddMonths(_horizonMonths));
        var schedule = result.ForStrategy(group.Strategy).PaymentSchedule
            .Where(p => p.Date <= cutoff);

        var autoDraftDebts = grp.Debts.ToDictionary(d => d.Id, d => d.PaymentMethod == DebtPaymentMethod.AutoDraft);

        var transactions = schedule
            .Where(p => effectiveBanks.TryGetValue(p.DebtId, out var bid) && bid.HasValue)
            .Select(p => new CashFlowTransaction
            {
                UserId = _userId,
                BankAccountId = effectiveBanks[p.DebtId]!.Value,
                TransactionDate = p.Date,
                Description = p.FeesAmount > 0
                    ? $"{p.DebtName} payment (incl. {p.FeesAmount.ToString("C")} fees)"
                    : $"{p.DebtName} payment",
                Amount = -(p.Amount + p.FeesAmount),
                Category = TransactionCategory.DebtPayment,
                ReferenceId = p.DebtId,
                DebtGroupId = group.Id,
                IsProjected = true,
                IsManualOverride = false,
                IsAutoDraft = autoDraftDebts.TryGetValue(p.DebtId, out var isAuto) && isAuto,
                GeneratedByStrategy = group.Strategy
            });

        await CashFlowRepo.BulkInsertProjectedAsync(transactions);
        _pushedGroupIds.Add(group.Id);
    }

    private async Task PushUngroupedDebt(Debt debt)
    {
        if (!debt.BankAccountId.HasValue) return;

        await CashFlowRepo.DeleteProjectedForSourceAsync(debt.Id, _userId, TransactionCategory.DebtPayment);

        var result = PayoffSvc.Calculate([debt], debt.MinimumPayment);
        var minOnly = result.ForStrategy(PayoffStrategy.MinimumOnly);
        if (minOnly.NeverPaysOff) return; // balance grows forever — no projection possible
        var cutoff = DateOnly.FromDateTime(DateTime.Today.AddMonths(_horizonMonths));
        var schedule = minOnly.PaymentSchedule
            .Where(p => p.Date <= cutoff);

        var transactions = schedule.Select(p => new CashFlowTransaction
        {
            UserId = _userId,
            BankAccountId = debt.BankAccountId!.Value,
            TransactionDate = p.Date,
            Description = p.FeesAmount > 0
                ? $"{p.DebtName} payment (incl. {p.FeesAmount.ToString("C")} fees)"
                : $"{p.DebtName} payment",
            Amount = -(p.Amount + p.FeesAmount),
            Category = TransactionCategory.DebtPayment,
            ReferenceId = p.DebtId,
            DebtGroupId = null,
            IsProjected = true,
            IsManualOverride = false,
            IsAutoDraft = debt.PaymentMethod == DebtPaymentMethod.AutoDraft,
            GeneratedByStrategy = PayoffStrategy.MinimumOnly
        });

        await CashFlowRepo.BulkInsertProjectedAsync(transactions);
        _pushedDebtIds.Add(debt.Id);
    }

    private void ConfirmDeleteGroup(DebtGroup g) => _deleteGroupTarget = g;

    private async Task MoveDebt(List<Debt> ordered, int index, int direction)
    {
        var swapIndex = index + direction;
        if (swapIndex < 0 || swapIndex >= ordered.Count) return;

        // Normalise sort orders to sequential positions, then swap the two affected
        for (int i = 0; i < ordered.Count; i++)
            ordered[i].GroupSortOrder = i;

        (ordered[index].GroupSortOrder, ordered[swapIndex].GroupSortOrder) =
            (ordered[swapIndex].GroupSortOrder, ordered[index].GroupSortOrder);

        await DebtRepo.UpdateAsync(ordered[index]);
        await DebtRepo.UpdateAsync(ordered[swapIndex]);
        await LoadAsync();
    }

    private async Task DeleteGroupConfirmed()
    {
        if (_deleteGroupTarget is null) return;
        await GroupRepo.DeleteAsync(_deleteGroupTarget.Id, _userId);
        _deleteGroupTarget = null;
        await LoadAsync();
    }

    // ── Debt CRUD ────────────────────────────────────────────────
    private void OpenAddDebt(int? groupId)
    {
        _editingDebt = new Debt { UserId = _userId, IsActive = true };
        _groupIdStr = groupId.HasValue ? groupId.Value.ToString() : string.Empty;
        _debtBankIdStr = string.Empty;
        _debtError = null;
        _showDebtModal = true;
        _editingFees = [];
        _deletedFeeIds = [];
        _newFeeName = string.Empty;
        _newFeeAmount = 0;
        _newFeeCategory = DebtFeeCategory.Other;
        _existingDebtShares = [];
        _debtSharedWithUserIds = [];
        _debtSharedWithGroupIds = [];
    }

    private async Task OpenEditDebt(Debt d)
    {
        _editingDebt = new Debt
        {
            Id = d.Id, UserId = d.UserId, GroupId = d.GroupId, GroupSortOrder = d.GroupSortOrder,
            BankAccountId = d.BankAccountId,
            Name = d.Name, Lender = d.Lender, Balance = d.Balance,
            InterestRate = d.InterestRate, MinimumPayment = d.MinimumPayment,
            IsFixedPayment = d.IsFixedPayment,
            PaymentDayOfMonth = d.PaymentDayOfMonth, LastPaymentDate = d.LastPaymentDate,
            PaymentMethod = d.PaymentMethod,
            PayoffDate = d.PayoffDate, IsActive = d.IsActive
        };
        _groupIdStr = d.GroupId.HasValue ? d.GroupId.Value.ToString() : string.Empty;
        _debtBankIdStr = d.BankAccountId.HasValue ? d.BankAccountId.Value.ToString() : string.Empty;
        _debtError = null;
        _showDebtModal = true;
        _editingFees = d.Fees.Select(f => new DebtFee
        {
            Id = f.Id, DebtId = f.DebtId, UserId = f.UserId,
            Name = f.Name, Amount = f.Amount, Category = f.Category, IsActive = f.IsActive
        }).ToList();
        _deletedFeeIds = [];
        _newFeeName = string.Empty;
        _newFeeAmount = 0;
        _newFeeCategory = DebtFeeCategory.Other;

        _existingDebtShares = (await ShareRepo.GetSharesForEntityAsync(ShareEntityType.Debt, d.Id)).ToList();
        _debtSharedWithUserIds = [.. _existingDebtShares.Where(s => s.SharedWithUserId.HasValue).Select(s => s.SharedWithUserId!.Value)];
        _debtSharedWithGroupIds = [.. _existingDebtShares.Where(s => s.SharedWithGroupId.HasValue).Select(s => s.SharedWithGroupId!.Value)];
    }

    private void CloseDebtModal() => _showDebtModal = false;

    private async Task SaveDebt()
    {
        if (string.IsNullOrWhiteSpace(_editingDebt.Name)) { _debtError = "Name is required."; return; }
        if (_editingDebt.Balance < 0) { _debtError = "Balance cannot be negative."; return; }
        _editingDebt.GroupId = int.TryParse(_groupIdStr, out var gid) ? gid : null;
        _editingDebt.BankAccountId = int.TryParse(_debtBankIdStr, out var bid) ? bid : null;
        _editingDebt.UserId = _userId;

        // Auto-assign sort order for new debts
        if (_editingDebt.Id == 0 && _editingDebt.GroupId.HasValue)
        {
            var groupDebts = _groups.FirstOrDefault(g => g.Id == _editingDebt.GroupId.Value)?.Debts;
            _editingDebt.GroupSortOrder = groupDebts?.Any() == true
                ? groupDebts.Max(d => d.GroupSortOrder) + 1
                : 0;
        }

        int savedId;
        if (_editingDebt.Id == 0)
            savedId = await DebtRepo.CreateAsync(_editingDebt);
        else
        {
            await DebtRepo.UpdateAsync(_editingDebt);
            savedId = _editingDebt.Id;
        }

        foreach (var feeId in _deletedFeeIds)
            await DebtRepo.DeleteFeeAsync(feeId, _userId);

        foreach (var fee in _editingFees)
        {
            fee.DebtId = savedId;
            fee.UserId = _userId;
            if (fee.Id == 0)
                await DebtRepo.CreateFeeAsync(fee);
            else
                await DebtRepo.UpdateFeeAsync(fee);
        }

        // Sync shares: remove unchecked, add newly checked
        foreach (var existing in _existingDebtShares)
        {
            bool stillChecked = existing.SharedWithUserId.HasValue
                ? _debtSharedWithUserIds.Contains(existing.SharedWithUserId.Value)
                : _debtSharedWithGroupIds.Contains(existing.SharedWithGroupId!.Value);
            if (!stillChecked)
                await ShareRepo.RemoveShareAsync(existing.Id, _userId);
        }
        foreach (var uid in _debtSharedWithUserIds)
        {
            if (!_existingDebtShares.Any(s => s.SharedWithUserId == uid))
                await ShareRepo.AddShareAsync(new SharePermission { EntityType = ShareEntityType.Debt, EntityId = savedId, GrantedByUserId = _userId, SharedWithUserId = uid });
        }
        foreach (var groupId in _debtSharedWithGroupIds)
        {
            if (!_existingDebtShares.Any(s => s.SharedWithGroupId == groupId))
                await ShareRepo.AddShareAsync(new SharePermission { EntityType = ShareEntityType.Debt, EntityId = savedId, GrantedByUserId = _userId, SharedWithGroupId = groupId });
        }

        _showDebtModal = false;
        await LoadAsync();
    }

    private void ConfirmDeleteDebt(Debt d) => _deleteDebtTarget = d;

    private void ToggleDebtShareUser(int userId, bool add)
    {
        if (add) _debtSharedWithUserIds.Add(userId);
        else _debtSharedWithUserIds.Remove(userId);
    }

    private void ToggleDebtShareGroup(int groupId, bool add)
    {
        if (add) _debtSharedWithGroupIds.Add(groupId);
        else _debtSharedWithGroupIds.Remove(groupId);
    }

    private async Task DeleteDebtConfirmed()
    {
        if (_deleteDebtTarget is null) return;
        await DebtRepo.DeleteAsync(_deleteDebtTarget.Id, _userId);
        _deleteDebtTarget = null;
        await LoadAsync();
    }

    private void AddFeeToList()
    {
        if (string.IsNullOrWhiteSpace(_newFeeName) || _newFeeAmount <= 0) return;
        _editingFees.Add(new DebtFee
        {
            Name = _newFeeName,
            Amount = _newFeeAmount,
            Category = _newFeeCategory,
            IsActive = true
        });
        _newFeeName = string.Empty;
        _newFeeAmount = 0;
        _newFeeCategory = DebtFeeCategory.Other;
    }

    private void RemoveFee(DebtFee fee)
    {
        _editingFees.Remove(fee);
        if (fee.Id > 0)
            _deletedFeeIds.Add(fee.Id);
    }

    private async Task ConfirmPayment(Debt debt)
    {
        await DebtRepo.UpdateLastPaymentAsync(debt.Id, _userId, DateOnly.FromDateTime(DateTime.Today));
        await LoadAsync();
    }
}
