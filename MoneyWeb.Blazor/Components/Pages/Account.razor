@page "/account"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject CurrentUserService CurrentUserSvc
@inject IUserRepository UserRepo
@inject NavigationManager Navigation

<PageTitle>My Account</PageTitle>

<h1 class="h3 mb-4">My Account</h1>

@if (_user is null)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else
{
    <div class="row">
        <div class="col-md-5">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Profile</h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">
                            @if (_editingName)
                            {
                                <div class="d-flex gap-2 align-items-center">
                                    <input class="form-control form-control-sm" @bind="_nameInput" style="max-width:200px" />
                                    <button class="btn btn-sm btn-primary" @onclick="SaveDisplayName">Save</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="() => _editingName = false">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <span>@_user.DisplayName</span>
                                <button class="btn btn-link btn-sm p-0 ms-2" @onclick="StartEditName">edit</button>
                            }
                        </dd>
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@_user.Email</dd>
                        <dt class="col-sm-4">Postal Code</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(_user.PostalCode))
                            {
                                @_user.PostalCode
                            }
                            else
                            {
                                <span class="text-muted">Not set</span>
                            }
                        </dd>
                        <dt class="col-sm-4">Member since</dt>
                        <dd class="col-sm-8">@_user.CreatedAt.ToString("MMMM d, yyyy")</dd>
                        <dt class="col-sm-4">Account type</dt>
                        <dd class="col-sm-8">
                            @if (_user.IsApproved)
                            {
                                <span class="badge bg-success">Free</span>
                                <span class="text-muted small ms-2">Full access to all features</span>
                            }
                            else if (_user.IsDeclined)
                            {
                                <span class="badge bg-danger">Declined</span>
                                @if (!string.IsNullOrWhiteSpace(_user.DeclineReason))
                                {
                                    <div class="text-muted small mt-1">Reason: @_user.DeclineReason</div>
                                }
                                <div class="mt-2">
                                    @if (!_requestingAgain)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => _requestingAgain = true">
                                            Request Access Again
                                        </button>
                                    }
                                    else
                                    {
                                        <div>
                                            <label class="form-label small">Why should you be approved?</label>
                                            <textarea class="form-control form-control-sm mb-2" rows="2"
                                                      placeholder="Briefly explain your reason..."
                                                      @bind="_requestReasonInput"></textarea>
                                            <button class="btn btn-sm btn-primary me-1" @onclick="SubmitAccessRequest">Send Request</button>
                                            <button class="btn btn-sm btn-secondary" @onclick="() => _requestingAgain = false">Cancel</button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                                <span class="text-muted small ms-2">Awaiting approval — features will unlock once approved</span>
                                @if (!string.IsNullOrWhiteSpace(_user.RequestReason))
                                {
                                    <div class="text-muted small fst-italic mt-1">Your note: @_user.RequestReason</div>
                                }
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            @if (_user.IsApproved)
            {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Preferences</h5>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Cash Flow Horizon
                            <span class="text-muted fw-normal">— how far forward to project transactions</span>
                        </label>
                        <div class="d-flex align-items-center gap-3">
                            <div class="flex-grow-1">
                                <input type="range" class="form-range w-100"
                                       min="1" max="60" step="1"
                                       value="@_user.CashFlowHorizonMonths"
                                       @oninput="e => _user.CashFlowHorizonMonths = int.Parse(e.Value!.ToString()!)" />
                                <div class="d-flex justify-content-between">
                                    <small class="text-muted">1 month</small>
                                    <small class="text-end text-muted">5 years</small>
                                </div>
                            </div>
                            <span class="text-nowrap fw-semibold" style="min-width:6rem">
                                @_user.CashFlowHorizonMonths mo
                                <span class="text-muted fw-normal small">(~@((_user.CashFlowHorizonMonths / 12.0m).ToString("0.#")) yr)</span>
                            </span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Navigation Sections</label>
                        <div class="text-muted small mb-2">Show or hide optional sections in the top menu.</div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="toggleSinkingFunds"
                                   checked="@_user.ShowSinkingFunds"
                                   @onchange="e => _user.ShowSinkingFunds = (bool)e.Value!" />
                            <label class="form-check-label" for="toggleSinkingFunds">Sinking Funds</label>
                        </div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="toggleLoans"
                                   checked="@_user.ShowLoans"
                                   @onchange="e => _user.ShowLoans = (bool)e.Value!" />
                            <label class="form-check-label" for="toggleLoans">Loans</label>
                        </div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="toggleFamily"
                                   checked="@_user.ShowFamily"
                                   @onchange="e => _user.ShowFamily = (bool)e.Value!" />
                            <label class="form-check-label" for="toggleFamily">Family</label>
                        </div>
                    </div>

                    @if (_prefsSaved)
                    {
                        <div class="alert alert-success py-1 px-2 small mb-2">Preferences saved.</div>
                    }
                    <button class="btn btn-primary btn-sm" @onclick="SavePreferences">Save Preferences</button>
                </div>
            </div>
            }

            <div class="card border-danger">
                <div class="card-body">
                    <h5 class="card-title text-danger">Danger Zone</h5>
                    <p class="text-muted small">
                        Permanently deletes all your debts, bills, loans, and transactions.
                        This cannot be undone.
                    </p>
                    @if (!_confirmingDelete)
                    {
                        <button class="btn btn-outline-danger" @onclick="() => _confirmingDelete = true">
                            Delete My Data
                        </button>
                    }
                    else
                    {
                        <p class="fw-bold text-danger">Are you absolutely sure?</p>
                        <button class="btn btn-danger me-2" @onclick="DeleteData">Yes, delete everything</button>
                        <button class="btn btn-secondary" @onclick="() => _confirmingDelete = false">Cancel</button>
                    }
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger mt-2">@_errorMessage</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private User? _user;
    private bool _confirmingDelete;
    private bool _prefsSaved;
    private string? _errorMessage;
    private bool _editingName;
    private string _nameInput = string.Empty;
    private bool _requestingAgain;
    private string _requestReasonInput = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUserSvc.GetCurrentUserAsync();
    }

    private void StartEditName()
    {
        _nameInput = _user?.DisplayName ?? string.Empty;
        _editingName = true;
    }

    private async Task SubmitAccessRequest()
    {
        if (_user is null || string.IsNullOrWhiteSpace(_requestReasonInput)) return;
        _user.IsDeclined = false;
        _user.DeclineReason = string.Empty;
        _user.RequestReason = _requestReasonInput.Trim();
        await UserRepo.UpdateAsync(_user);
        _requestingAgain = false;
        _requestReasonInput = string.Empty;
    }

    private async Task SaveDisplayName()
    {
        if (_user is null || string.IsNullOrWhiteSpace(_nameInput)) return;
        _user.DisplayName = _nameInput.Trim();
        await UserRepo.UpdateAsync(_user);
        _editingName = false;
    }

    private async Task SavePreferences()
    {
        if (_user is null) return;
        _user.CashFlowHorizonMonths = Math.Clamp(_user.CashFlowHorizonMonths, 1, 60);
        await UserRepo.UpdateAsync(_user);
        _prefsSaved = true;
        _ = Task.Delay(3000).ContinueWith(_ => { _prefsSaved = false; InvokeAsync(StateHasChanged); });
    }

    private async Task DeleteData()
    {
        if (_user is null) return;
        try
        {
            await UserRepo.DeleteUserDataAsync(_user.Id);
            Navigation.NavigateTo("/auth/logout", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete data: {ex.Message}";
            _confirmingDelete = false;
        }
    }
}
