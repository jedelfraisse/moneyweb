@inherits LayoutComponentBase

<NavMenu />

<main>
    <article class="content px-4 py-3">
        @Body
    </article>
</main>

<footer class="border-top mt-4 py-3 px-4 text-muted small">
    <span>&copy; @DateTime.Now.Year Delfraisse.com</span>
    <span class="mx-2">·</span>
    <a href="/terms" class="text-muted">Terms of Service</a>
    <span class="mx-2">·</span>
    <a href="/privacy" class="text-muted">Privacy Policy</a>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

