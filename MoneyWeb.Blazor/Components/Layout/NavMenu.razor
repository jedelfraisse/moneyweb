@using Microsoft.AspNetCore.Components.Authorization
@inject CurrentUserService CurrentUserSvc

<nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow-sm">
    <div class="container-xl">
        <a class="navbar-brand fw-semibold" href="/">💰 MoneyWeb</a>
        <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="@(_navCollapsed ? "collapse" : "") navbar-collapse">
            <AuthorizeView>
                <Authorized>
                    @if (_isApproved)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <NavLink class="nav-link" href="bank-accounts">Bank Accounts</NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="income">Income</NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="debts">Debts</NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="bills">Bills</NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="sinking-funds">Sinking Funds</NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="loans">Loans</NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="sharing">Sharing</NavLink>
                            </li>
                        </ul>
                    }
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        @if (_isAdmin)
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link" href="admin/users">⚙️ Admin</NavLink>
                            </li>
                        }
                        <li class="nav-item">
                            <NavLink class="nav-link" href="account">👤 @_displayName</NavLink>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="MicrosoftIdentity/Account/SignOut">Sign Out</a>
                        </li>
                    </ul>
                </Authorized>
                <NotAuthorized>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="MicrosoftIdentity/Account/SignIn">Sign In</a>
                        </li>
                    </ul>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private bool _isApproved;
    private bool _isAdmin;
    private string _displayName = string.Empty;
    private bool _navCollapsed = true;

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUserSvc.GetCurrentUserAsync();
        _isApproved = user?.IsApproved == true;
        _isAdmin = user?.IsAdmin == true;
        _displayName = user?.DisplayName ?? string.Empty;
    }

    private void ToggleNavMenu() => _navCollapsed = !_navCollapsed;
}


