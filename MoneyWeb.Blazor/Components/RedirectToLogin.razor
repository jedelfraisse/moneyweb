@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        // returnUrl must be relative — the login endpoints only accept a relative LocalRedirect target.
        var relativePath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(relativePath)}", forceLoad: true);
    }
}
